<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FitLife.Maui"
             xmlns:converters="clr-namespace:FitLife.Maui.Converters"
             x:Class="FitLife.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:IntegerToBoolConverter x:Key="IntegerToBoolConverter" />
            <converters:WorkoutColorConverter x:Key="WorkoutColorConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

            <Color x:Key="Primary">#5B6636</Color>
            <Color x:Key="Secondary">#DEDEDE</Color>
            <Color x:Key="Tertiary">#1F1F1F</Color>

        </ResourceDictionary>
    </Application.Resources>
</Application>
