<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:h="clr-namespace:FitLife.Maui.Helpers"
             x:Class="FitLife.Maui.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LightGray}"
             Title="Instellingen">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,8">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Label Text="{h:Translate Settings_Title}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18"
                   HorizontalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,40" Spacing="28">

                <!-- ══════════════════════════════════════
                     TAAL
                ══════════════════════════════════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{h:Translate Settings_Language}"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="4,0,0,0" />

                    <Border BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout>

                            <!-- Nederlands -->
                            <Grid ColumnDefinitions="*, Auto" Padding="16,15" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}"
                                                          CommandParameter="nl" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0"
                                       Text="Nederlands"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Tertiary}" />
                                <Border Grid.Column="1"
                                        WidthRequest="22" HeightRequest="22"
                                        StrokeThickness="2"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding LanguageNl}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding LanguageNl}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource Gray300}" />
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Ellipse WidthRequest="10" HeightRequest="10"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             InputTransparent="True">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding LanguageNl}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding LanguageNl}" Value="False">
                                                <Setter Property="Fill" Value="Transparent" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Margin="16,0" Color="{StaticResource Gray100}" />

                            <!-- English -->
                            <Grid ColumnDefinitions="*, Auto" Padding="16,15" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}"
                                                          CommandParameter="en" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0"
                                       Text="English"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Tertiary}" />
                                <Border Grid.Column="1"
                                        WidthRequest="22" HeightRequest="22"
                                        StrokeThickness="2"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding LanguageEn}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding LanguageEn}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource Gray300}" />
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Ellipse WidthRequest="10" HeightRequest="10"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             InputTransparent="True">
                                        <Ellipse.Triggers>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding LanguageEn}" Value="True">
                                                <Setter Property="Fill" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Ellipse" Binding="{Binding LanguageEn}" Value="False">
                                                <Setter Property="Fill" Value="Transparent" />
                                            </DataTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Border>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ══════════════════════════════════════
                     NOTIFICATIES
                ══════════════════════════════════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{h:Translate Settings_Notifications}"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="4,0,0,0" />

                    <Border BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout>

                            <!-- Wachtlijst -->
                            <Grid ColumnDefinitions="*, Auto" Padding="16,14" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{h:Translate Settings_Waitlist}"
                                           FontSize="15"
                                           TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{h:Translate Settings_WaitlistDesc}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding NotifyWaitlist}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Margin="16,0" Color="{StaticResource Gray100}" />

                            <!-- Pushmeldingen -->
                            <Grid ColumnDefinitions="*, Auto" Padding="16,14" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{h:Translate Settings_Push}"
                                           FontSize="15"
                                           TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{h:Translate Settings_PushDesc}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding NotifyPush}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Margin="16,0" Color="{StaticResource Gray100}" />

                            <!-- Afgelaste trainingen -->
                            <Grid ColumnDefinitions="*, Auto" Padding="16,14" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{h:Translate Settings_Cancelled}"
                                           FontSize="15"
                                           TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{h:Translate Settings_CancelledDesc}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding NotifyCancelled}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Margin="16,0" Color="{StaticResource Gray100}" />

                            <!-- Algemeen & Nieuws -->
                            <Grid ColumnDefinitions="*, Auto" Padding="16,14" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{h:Translate Settings_News}"
                                           FontSize="15"
                                           TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{h:Translate Settings_NewsDesc}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding NotifyNews}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ══════════════════════════════════════
                     LOCATIE
                ══════════════════════════════════════ -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{h:Translate Settings_Location}"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="4,0,0,0" />

                    <Border BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout>

                            <Grid ColumnDefinitions="*, Auto" Padding="16,14" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{h:Translate Settings_LocationSharing}"
                                           FontSize="15"
                                           TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{h:Translate Settings_LocationSharingDesc}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding LocationSharing}"
                                        OnColor="{StaticResource Primary}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{h:Translate Settings_LocationInfo}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray400}"
                                   Padding="16,0,16,14"
                                   LineBreakMode="WordWrap" />

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>