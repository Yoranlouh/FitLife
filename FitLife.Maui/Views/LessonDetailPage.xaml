<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:services="clr-namespace:FitLife.Maui.Services"
             xmlns:h="clr-namespace:FitLife.Maui.Helpers"
             x:Class="FitLife.Maui.Views.LessonDetailPage"
             x:Name="LessonDetailRoot"
             Title="{Binding Title}"
             x:DataType="vm:LessonDetailViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,8">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked"
                    AutomationId="DetailBackBtn" />
            <Label Text="{Binding Lesson.WorkoutName}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18"
                   HorizontalOptions="Center"
                   AutomationId="DetailWorkoutName" />
        </Grid>
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="0">
            <!-- Title and Date/Time -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Lesson.WorkoutName}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="Black"/>
                    <Label Text="{Binding Lesson.StartTime, StringFormat='{0:dddd, d MMMM yyyy}'}" 
                           FontSize="16"
                           TextColor="Black"/>
                </VerticalStackLayout>
                <Label Grid.Column="1" 
                       Text="{Binding Lesson.StartTime, StringFormat='{0:HH:mm}'}" 
                       FontSize="32" 
                       VerticalOptions="Start"
                       TextColor="Black"/>
            </Grid>

            <!-- Location -->
            <HorizontalStackLayout Spacing="8" Margin="0,0,0,20">
                <Label Text="📍" FontSize="14" VerticalOptions="Center"/>
                <Label Text="{Binding Lesson.LocationName}"
                       FontSize="14"
                       TextColor="Black"
                       VerticalOptions="Center"
                       AutomationId="DetailLocation"/>
            </HorizontalStackLayout>

            <!-- FitLife Text replacement for logo -->
            <Label Text="FitLife." 
                   FontSize="80" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="Black"
                   Margin="0,0,0,20"/>

            <!-- Info block below logo -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <VerticalStackLayout>
                    <Label Text="{Binding Lesson.LocationName}"
                           FontSize="14"
                           TextColor="Black" />
                    <Label Text="{Binding SubscriptionLineDisplay}"
                           FontSize="14"
                           TextColor="Gray" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                    <Label Text="{Binding CreditsDisplay}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="End"
                           TextColor="Black" />
                    <Label Text="{Binding RenewalDateDisplay}"
                           FontSize="12"
                           HorizontalOptions="End"
                           TextColor="Gray"
                           IsVisible="{Binding RenewalDateDisplay,
                               Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Action Button: Aanmelden -->
            <Button Text="{h:Translate Detail_Register}"
                    Command="{Binding ReserveCommand}"
                    IsVisible="{Binding ShowReserveButton}"
                    BackgroundColor="#C5E17A"
                    TextColor="Black"
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,0,0,10"
                    AutomationId="DetailReserveBtn" />

            <!-- Knop: les is al gestart of voorbij -->
            <Button Text="{h:Translate Detail_RegisterClosed}"
                    IsVisible="{Binding ShowExpiredMessage}"
                    IsEnabled="False"
                    BackgroundColor="#E0E0E0"
                    TextColor="#9E9E9E"
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,0,0,10"
                    AutomationId="DetailExpiredBtn" />

            <!-- Melding: te vroeg om te reserveren -->
            <Border IsVisible="{Binding IsTooFarInFuture}"
                    BackgroundColor="#FFF8E1"
                    Stroke="#FFD54F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="📅" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="{Binding ReservationOpenDateText}"
                           FontSize="13"
                           TextColor="#5D4037"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Afmelden knop -->
            <Button Text="{h:Translate Detail_Unregister}"
                    Command="{Binding UnregisterCommand}"
                    IsVisible="{Binding IsReserved}"
                    IsEnabled="{Binding IsCancellationDeadlinePassed, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#FF3B30"
                    TextColor="White"
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,0,0,8"
                    AutomationId="DetailUnregisterBtn" />

            <!-- Melding: afmelden niet meer mogelijk -->
            <Border IsVisible="{Binding ShowCancellationDeadlineWarning}"
                    BackgroundColor="#FFF3F3"
                    Stroke="#FF3B30"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="{h:Translate Detail_CancelDeadline}"
                           FontSize="13"
                           TextColor="#C62828"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- ── Fiets selectie (alleen voor spinninglessen) ── -->
            <Border IsVisible="{Binding ShowBikeSection}"
                    BackgroundColor="#F8FFF0"
                    Stroke="#C5E17A"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="16,14"
                    Margin="0,8,0,4">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{h:Translate Spinning_SelectBikeTitle}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#5B6636"
                           CharacterSpacing="0.5"/>

                    <!-- Geselecteerde fiets badge -->
                    <Border IsVisible="{Binding HasBikeSelected}"
                            BackgroundColor="#E8F5E9"
                            Stroke="#4CAF50"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            Padding="10,8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🚲" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding SelectedBikeDisplay}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#2E7D32"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 4×4 fietsrooster — elk vakje toont het fietsnummer (1 t/m 16) -->
                    <CollectionView ItemsSource="{Binding BikeOptions}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="4"
                                             VerticalItemSpacing="6"
                                             HorizontalItemSpacing="6"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:BikeItem">
                                <Border StrokeShape="RoundRectangle 6"
                                        StrokeThickness="{Binding StrokeThickness}"
                                        Stroke="{Binding StrokeColor}"
                                        BackgroundColor="{Binding BackgroundColor}"
                                        Padding="0"
                                        HeightRequest="48">
                                    <Button Text="{Binding DisplayLabel}"
                                            TextColor="{Binding TextColor}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            IsEnabled="{Binding IsAvailable}"
                                            Command="{Binding BindingContext.SelectBikeCommand, Source={x:Reference LessonDetailRoot}}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="46"
                                            Padding="0"
                                            AutomationId="{Binding DisplayLabel, StringFormat='BikeCell_{0}'}"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Legenda: maakt vrij / jouw fiets / bezet visueel duidelijk -->
                    <HorizontalStackLayout Spacing="14" Margin="0,2,0,0">
                        <HorizontalStackLayout Spacing="5">
                            <Border WidthRequest="14" HeightRequest="14"
                                    BackgroundColor="#F5F5F5" Stroke="#CCCCCC"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 3"
                                    VerticalOptions="Center"/>
                            <Label Text="{h:Translate Spinning_LegendFree}"
                                   FontSize="11" TextColor="#5B6636" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Border WidthRequest="14" HeightRequest="14"
                                    BackgroundColor="#C5E17A" Stroke="#2E7D32"
                                    StrokeThickness="2" StrokeShape="RoundRectangle 3"
                                    VerticalOptions="Center"/>
                            <Label Text="{h:Translate Spinning_LegendYours}"
                                   FontSize="11" TextColor="#5B6636" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <Border WidthRequest="14" HeightRequest="14"
                                    BackgroundColor="#FFCDD2" Stroke="#E59A9A"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 3"
                                    VerticalOptions="Center"/>
                            <Label Text="{h:Translate Spinning_LegendTaken}"
                                   FontSize="11" TextColor="#5B6636" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ── Aanwezigheidsregistratie ── -->
            <BoxView HeightRequest="1"
                     BackgroundColor="#E5E5E5"
                     HorizontalOptions="Fill"
                     IsVisible="{Binding ShowCheckInSection}"
                     Margin="0,0,0,0"/>

            <VerticalStackLayout IsVisible="{Binding ShowCheckInSection}"
                                 Padding="0,14,0,8"
                                 Spacing="10">

                <Label Text="{h:Translate Attendance_SectionTitle}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="Gray"
                       CharacterSpacing="1"/>

                <!-- Aanwezig-badge (na succesvolle check-in) -->
                <Border IsVisible="{Binding ShowCheckedInBadge}"
                        BackgroundColor="#E8F5E9"
                        Stroke="#4CAF50"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,12"
                        AutomationId="DetailCheckedInBadge">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="18" FontAttributes="Bold"
                               TextColor="#2E7D32" VerticalOptions="Center"/>
                        <Label Text="{h:Translate Attendance_CheckedIn}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#2E7D32" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Te vroeg: check-in-window is nog niet open -->
                <Border IsVisible="{Binding ShowCheckInEarlyMessage}"
                        BackgroundColor="#F5F5F5"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="🕐" FontSize="15" VerticalOptions="Center"/>
                        <Label Text="{Binding CheckInEarlyText}"
                               FontSize="13" TextColor="#616161"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Les beëindigd zonder inchecken -->
                <Border IsVisible="{Binding ShowLessonEndedMessage}"
                        BackgroundColor="#F5F5F5"
                        Stroke="#BDBDBD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="14,12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="⏹" FontSize="15" VerticalOptions="Center"/>
                        <Label Text="{h:Translate Attendance_LessonEnded}"
                               FontSize="13" TextColor="#616161"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- RFID inchecken (handmatig) -->
                <Button Text="{h:Translate Attendance_CheckInBtn}"
                        Command="{Binding CheckInRfidCommand}"
                        IsVisible="{Binding ShowCheckInButtons}"
                        BackgroundColor="#1A1A1A"
                        TextColor="White"
                        CornerRadius="5"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        AutomationId="DetailCheckInBtn" />

                <!-- GPS inchecken (simulatie) — alleen zichtbaar als locatie-toestemming actief is -->
                <Button Text="{h:Translate Attendance_SimulateGps}"
                        Command="{Binding CheckInGpsCommand}"
                        IsVisible="{Binding ShowGpsCheckInButton}"
                        BackgroundColor="#37474F"
                        TextColor="White"
                        CornerRadius="5"
                        HeightRequest="50"/>

            </VerticalStackLayout>

            <!-- Details Grid -->
            <BoxView HeightRequest="1" BackgroundColor="#E5E5E5" HorizontalOptions="Fill"/>
            
            <Grid ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto, Auto" Padding="0,15" RowSpacing="15">
                <!-- Trainer -->
                <Label Text="👥" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" Margin="0,0,10,0"/>
                <VerticalStackLayout Grid.Column="1" Grid.Row="0">
                    <Label Text="{h:Translate Detail_Trainer}" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding Lesson.InstructorName}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>

                <!-- Betaalmethode -->
                <VerticalStackLayout Grid.Column="3" Grid.Row="0">
                    <Label Text="{h:Translate Detail_PaymentMethod}" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding CreditsDisplay}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>

                <!-- Credits resterend -->
                <Label Text="💳" Grid.Column="0" Grid.Row="1" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Label Text="{Binding SubscriptionName}" Grid.Column="1" Grid.Row="1"
                       VerticalOptions="Center" TextColor="Black"/>

                <!-- Eindtijd -->
                <VerticalStackLayout Grid.Column="3" Grid.Row="1">
                    <Label Text="{h:Translate Detail_EndTime}" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding Lesson.EndTime, StringFormat='{0:HH:mm}'}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#E5E5E5" HorizontalOptions="Fill"/>

            <!-- Participants Link -->
            <Grid Padding="0,15" ColumnDefinitions="*, Auto" AutomationId="DetailParticipants">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToParticipantsCommand}"/>
                </Grid.GestureRecognizers>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{h:Translate Detail_Participants}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                    <Label Text="{Binding ParticipantCount}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                    <Label Text="/" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                    <Label Text="{Binding MaxParticipants}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Column="1" Text="›" FontSize="24" TextColor="Black" VerticalOptions="Center"/>
            </Grid>

            <!-- Aanvullende informatie -->
            <BoxView HeightRequest="40" BackgroundColor="#E5E5E5" HorizontalOptions="Fill" Margin="-20,0"/>
            <VerticalStackLayout Padding="0,16" Spacing="12">
                <Label Text="{h:Translate Detail_AdditionalInfo}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="Black"/>
                <Grid ColumnDefinitions="24, *" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="⏱" FontSize="15" VerticalOptions="Start" Margin="0,1,0,0"/>
                    <Label Grid.Column="1"
                           Text="{h:Translate Detail_CancelInfo}"
                           FontSize="14"
                           TextColor="Black"
                           LineBreakMode="WordWrap"/>
                </Grid>
                <Grid ColumnDefinitions="24, *" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="📅" FontSize="15" VerticalOptions="Start" Margin="0,1,0,0"/>
                    <Label Grid.Column="1"
                           Text="{h:Translate Detail_ReserveInfo}"
                           FontSize="14"
                           TextColor="Black"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
