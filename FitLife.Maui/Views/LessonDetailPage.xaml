<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             x:Class="FitLife.Maui.Views.LessonDetailPage"
             Title="{Binding Title}"
             x:DataType="vm:LessonDetailViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,8">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Label Text="{Binding Lesson.WorkoutName}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18"
                   HorizontalOptions="Center" />
        </Grid>
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="0">
            <!-- Title and Date/Time -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Lesson.WorkoutName}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="Black"/>
                    <Label Text="{Binding Lesson.StartTime, StringFormat='{0:dddd, d MMMM yyyy}'}" 
                           FontSize="16"
                           TextColor="Black"/>
                </VerticalStackLayout>
                <Label Grid.Column="1" 
                       Text="{Binding Lesson.StartTime, StringFormat='{0:HH:mm}'}" 
                       FontSize="32" 
                       VerticalOptions="Start"
                       TextColor="Black"/>
            </Grid>

            <!-- Location -->
            <HorizontalStackLayout Spacing="8" Margin="0,0,0,20">
                <Label Text="📍" FontSize="14" VerticalOptions="Center"/>
                <Label Text="{Binding Lesson.LocationName}" 
                       FontSize="14" 
                       TextColor="Black" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- FitLife Text replacement for logo -->
            <Label Text="FitLife." 
                   FontSize="80" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="Black"
                   Margin="0,0,0,20"/>

            <!-- Info block below logo -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                <VerticalStackLayout>
                    <Label Text="{Binding Lesson.LocationName}"
                           FontSize="14"
                           TextColor="Black" />
                    <Label Text="{Binding SubscriptionLineDisplay}"
                           FontSize="14"
                           TextColor="Gray" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                    <Label Text="{Binding CreditsDisplay}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="End"
                           TextColor="Black" />
                    <Label Text="{Binding RenewalDateDisplay}"
                           FontSize="12"
                           HorizontalOptions="End"
                           TextColor="Gray"
                           IsVisible="{Binding RenewalDateDisplay,
                               Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Action Button: Aanmelden -->
            <Button Text="Aanmelden"
                    Command="{Binding ReserveCommand}"
                    IsVisible="{Binding ShowReserveButton}"
                    BackgroundColor="#C5E17A"
                    TextColor="Black"
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,0,0,10"/>

            <!-- Knop: les is al gestart of voorbij -->
            <Button Text="Aanmelden niet meer mogelijk"
                    IsVisible="{Binding ShowExpiredMessage}"
                    IsEnabled="False"
                    BackgroundColor="#E0E0E0"
                    TextColor="#9E9E9E"
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,0,0,10"/>

            <!-- Melding: te vroeg om te reserveren -->
            <Border IsVisible="{Binding IsTooFarInFuture}"
                    BackgroundColor="#FFF8E1"
                    Stroke="#FFD54F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="📅" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="{Binding ReservationOpenDateText}"
                           FontSize="13"
                           TextColor="#5D4037"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Afmelden knop -->
            <Button Text="Afmelden"
                    Command="{Binding UnregisterCommand}"
                    IsVisible="{Binding IsReserved}"
                    IsEnabled="{Binding IsCancellationDeadlinePassed, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#FF3B30"
                    TextColor="White"
                    CornerRadius="5"
                    HeightRequest="50"
                    FontAttributes="Bold"
                    Margin="0,0,0,8"/>

            <!-- Melding: afmelden niet meer mogelijk -->
            <Border IsVisible="{Binding ShowCancellationDeadlineWarning}"
                    BackgroundColor="#FFF3F3"
                    Stroke="#FF3B30"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10"
                    Margin="0,0,0,20">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="⚠" FontSize="16" VerticalOptions="Center"/>
                    <Label Text="Afmelden is niet meer mogelijk (minder dan 1 uur voor aanvang)."
                           FontSize="13"
                           TextColor="#C62828"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"
                           HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Details Grid -->
            <BoxView HeightRequest="1" BackgroundColor="#E5E5E5" HorizontalOptions="Fill"/>
            
            <Grid ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto, Auto" Padding="0,15" RowSpacing="15">
                <!-- Trainer -->
                <Label Text="👥" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" Margin="0,0,10,0"/>
                <VerticalStackLayout Grid.Column="1" Grid.Row="0">
                    <Label Text="Trainer" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding Lesson.InstructorName}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>

                <!-- Betaalmethode -->
                <VerticalStackLayout Grid.Column="3" Grid.Row="0">
                    <Label Text="Betaalmethode" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding CreditsDisplay}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>

                <!-- Credits resterend -->
                <Label Text="💳" Grid.Column="0" Grid.Row="1" VerticalOptions="Center" Margin="0,0,10,0"/>
                <Label Text="{Binding SubscriptionName}" Grid.Column="1" Grid.Row="1"
                       VerticalOptions="Center" TextColor="Black"/>

                <!-- Eindtijd -->
                <VerticalStackLayout Grid.Column="3" Grid.Row="1">
                    <Label Text="Eindtijd" FontSize="14" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding Lesson.EndTime, StringFormat='{0:HH:mm}'}" FontSize="14" TextColor="Black"/>
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="#E5E5E5" HorizontalOptions="Fill"/>

            <!-- Participants Link -->
            <Grid Padding="0,15" ColumnDefinitions="*, Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToParticipantsCommand}"/>
                </Grid.GestureRecognizers>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Deelnemers" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                    <Label Text="{Binding ParticipantCount}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                    <Label Text="/" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                    <Label Text="{Binding MaxParticipants}" FontSize="16" TextColor="Black" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Column="1" Text="›" FontSize="24" TextColor="Black" VerticalOptions="Center"/>
            </Grid>

            <!-- Aanvullende informatie -->
            <BoxView HeightRequest="40" BackgroundColor="#E5E5E5" HorizontalOptions="Fill" Margin="-20,0"/>
            <VerticalStackLayout Padding="0,16" Spacing="12">
                <Label Text="Aanvullende informatie"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="Black"/>
                <Grid ColumnDefinitions="24, *" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="⏱" FontSize="15" VerticalOptions="Start" Margin="0,1,0,0"/>
                    <Label Grid.Column="1"
                           Text="Je kunt je afmelden tot 1 uur voor aanvang van de les."
                           FontSize="14"
                           TextColor="Black"
                           LineBreakMode="WordWrap"/>
                </Grid>
                <Grid ColumnDefinitions="24, *" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="📅" FontSize="15" VerticalOptions="Start" Margin="0,1,0,0"/>
                    <Label Grid.Column="1"
                           Text="Reserveren is mogelijk tot maximaal 1 week van tevoren."
                           FontSize="14"
                           TextColor="Black"
                           LineBreakMode="WordWrap"/>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
