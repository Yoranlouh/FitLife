<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             x:Class="FitLife.Maui.Views.LessonDetailPage"
             Title="{Binding Title}"
             x:DataType="vm:LessonDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{Binding Lesson.WorkoutName}" 
                           TextColor="White" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding Lesson.InstructorName}" 
                           TextColor="White" 
                           HorizontalOptions="Center" 
                           FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                <Label Text="Tijd:" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                <Label Text="{Binding Lesson.StartTime, StringFormat='{0:dddd dd MMMM HH:mm}'}" Grid.Row="0" Grid.Column="1"/>

                <Label Text="Locatie:" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                <Label Text="{Binding Lesson.LocationName}" Grid.Row="1" Grid.Column="1"/>

                <Label Text="Plekken:" FontAttributes="Bold" Grid.Row="2" Grid.Column="0"/>
                <Label Text="{Binding Lesson.MaxParticipants}" Grid.Row="2" Grid.Column="1"/>
            </Grid>

            <Line X2="400" Stroke="Gray" StrokeThickness="1"/>

            <VerticalStackLayout Spacing="10">
                <Button Text="Reserveren" 
                        Command="{Binding ReserveCommand}" 
                        IsVisible="{Binding IsReserved, Converter={StaticResource InvertedBoolConverter}}" />
                
                <Button Text="Afmelden" 
                        Command="{Binding UnregisterCommand}" 
                        IsVisible="{Binding IsReserved}" 
                        BackgroundColor="Red" />

                <Button Text="Op Wachtlijst" 
                        Command="{Binding JoinWaitlistCommand}" 
                        IsVisible="{Binding IsOnWaitlist, Converter={StaticResource InvertedBoolConverter}}" />
                
                <Label Text="Je staat op de wachtlijst voor deze les." 
                       IsVisible="{Binding IsOnWaitlist}" 
                       TextColor="Orange" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
