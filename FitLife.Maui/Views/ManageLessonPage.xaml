<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             x:Class="FitLife.Maui.Views.ManageLessonPage"
             x:DataType="vm:ManageLessonViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              ColumnDefinitions="Auto, *"
              Padding="10,8">
            <ImageButton Source="back_icon.png"
                         WidthRequest="20" HeightRequest="20"
                         VerticalOptions="Center"
                         Clicked="OnBackToHomeClicked" />
            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Workout type -->
                <Label Text="Workout Type" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                <Picker Title="Selecteer workout..."
                        ItemsSource="{Binding Workouts}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedWorkout}"
                        BackgroundColor="White" />

                <!-- Datum -->
                <Label Text="Datum" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                <DatePicker Date="{Binding StartDate}"
                            Format="dd-MM-yyyy"
                            BackgroundColor="White" />

                <!-- Begintijd -->
                <Label Text="Begintijd" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                <TimePicker Time="{Binding StartTime}"
                            Format="HH:mm"
                            BackgroundColor="White" />

                <!-- Eindtijd -->
                <Label Text="Eindtijd" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                <TimePicker Time="{Binding EndTime}"
                            Format="HH:mm"
                            BackgroundColor="White" />

                <!-- Max deelnemers -->
                <Label Text="Max. deelnemers" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                <Entry Keyboard="Numeric"
                       Text="{Binding MaxParticipants}"
                       Placeholder="bijv. 15"
                       BackgroundColor="White" />

                <!-- Locatie/Zaal -->
                <Label Text="Locatie / Zaal" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                <Picker Title="Selecteer locatie..."
                        ItemsSource="{Binding Locations}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedLocation}"
                        BackgroundColor="White" />

                <!-- Instructeur (alleen voor admin) -->
                <VerticalStackLayout IsVisible="{Binding IsAdmin}" Spacing="8">
                    <Label Text="Instructeur" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                    <Picker Title="Selecteer instructeur..."
                            ItemsSource="{Binding Instructors}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedInstructor}"
                            BackgroundColor="White" />
                </VerticalStackLayout>

                <!-- Instructeur weergave (trainer ziet zichzelf) -->
                <VerticalStackLayout IsVisible="{Binding IsAdmin, Converter={StaticResource InvertedBoolConverter}}" Spacing="4">
                    <Label Text="Instructeur" FontAttributes="Bold" FontSize="14" TextColor="#333" />
                    <Label Text="{Binding SelectedInstructor.Name, FallbackValue='Jij (als trainer)'}"
                           FontSize="14"
                           TextColor="#5B6636" />
                </VerticalStackLayout>

                <!-- Statusbericht -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                       TextColor="#D32F2F"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />

                <!-- Opslaan knop -->
                <Button Text="{Binding SaveButtonText}"
                        Command="{Binding SaveLessonCommand}"
                        BackgroundColor="#5B6636"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,8,0,0" />

                <!-- Lid toevoegen sectie (alleen bij bewerkingsmodus) -->
                <VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="10" Margin="0,16,0,0">
                    <BoxView HeightRequest="1" Color="#E0E0E0" />
                    <Label Text="Lid Toevoegen aan Les"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#333" />
                    <Label Text="Voer het gebruikers-ID in van het lid dat je wilt toevoegen:"
                           FontSize="13"
                           TextColor="Gray" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0"
                               Placeholder="Gebruikers-ID"
                               Keyboard="Numeric"
                               Text="{Binding AddMemberInput}"
                               BackgroundColor="White" />
                        <Button Grid.Column="1"
                                Text="Toevoegen"
                                Command="{Binding AddMemberCommand}"
                                BackgroundColor="#5B6636"
                                TextColor="White"
                                CornerRadius="8"
                                Padding="12,0" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <BoxView IsVisible="{Binding IsBusy}"
                 InputTransparent="False"
                 Color="Black"
                 Opacity="0.25" />
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="#5B6636" />
    </Grid>
</ContentPage>