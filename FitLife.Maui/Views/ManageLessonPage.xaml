<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:h="clr-namespace:FitLife.Maui.Helpers"
             x:Class="FitLife.Maui.Views.ManageLessonPage"
             x:DataType="vm:ManageLessonViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource LightGray}"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,8">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Label Text="{Binding Title}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18"
                   HorizontalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,40" Spacing="20">

                <!-- Laden-indicator tekst -->
                <Label Text="{h:Translate Manage_Loading}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsBusy}" />

                <!-- ── Workout ── -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{h:Translate Manage_WorkoutType}"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="2,0,0,0" />
                    <Border BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectWorkoutCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto" Padding="16,15">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedWorkoutName}"
                                   FontSize="15"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedWorkout}"
                                                 Value="{x:Null}">
                                        <Setter Property="TextColor" Value="{StaticResource Gray400}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Datum ── -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{h:Translate Manage_Date}"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="2,0,0,0" />
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="16,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <DatePicker Date="{Binding StartDate}"
                                    Format="dd-MM-yyyy"
                                    TextColor="{StaticResource Tertiary}"
                                    FontSize="15"
                                    BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- ── Begin- en eindtijd ── -->
                <Grid ColumnDefinitions="*, 16, *">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="{h:Translate Manage_StartTime}"
                               FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.5"
                               TextColor="{StaticResource Gray500}"
                               Margin="2,0,0,0" />
                        <Border BackgroundColor="White" StrokeThickness="0" Padding="16,6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <TimePicker Time="{Binding StartTime}"
                                        Format="HH:mm"
                                        TextColor="{StaticResource Tertiary}"
                                        FontSize="15"
                                        BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="{h:Translate Manage_EndTime}"
                               FontSize="11" FontAttributes="Bold"
                               CharacterSpacing="1.5"
                               TextColor="{StaticResource Gray500}"
                               Margin="2,0,0,0" />
                        <Border BackgroundColor="White" StrokeThickness="0" Padding="16,6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <TimePicker Time="{Binding EndTime}"
                                        Format="HH:mm"
                                        TextColor="{StaticResource Tertiary}"
                                        FontSize="15"
                                        BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- ── Locatie ── -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{h:Translate Manage_Location}"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="2,0,0,0" />
                    <Border BackgroundColor="White" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectLocationCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto" Padding="16,15">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedLocationName}"
                                   FontSize="15"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedLocation}"
                                                 Value="{x:Null}">
                                        <Setter Property="TextColor" Value="{StaticResource Gray400}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Instructeur ── -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{h:Translate Manage_Instructor}"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="2,0,0,0" />

                    <!-- Staf (trainer of admin): kies instructeur via popup -->
                    <Border BackgroundColor="White" StrokeThickness="0"
                            IsVisible="{Binding CanAssignInstructor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectInstructorCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*, Auto" Padding="16,15">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedInstructorName}"
                                   FontSize="15"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedInstructor}"
                                                 Value="{x:Null}">
                                        <Setter Property="TextColor" Value="{StaticResource Gray400}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Fallback: alleen-lezen instructeur (alleen zichtbaar als kiezen niet mag) -->
                    <Border BackgroundColor="White" StrokeThickness="0"
                            IsVisible="{Binding CanAssignInstructor, Converter={StaticResource InvertedBoolConverter}}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" Padding="16,15">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedInstructorName}"
                                   FontSize="15"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="🔒"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray400}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Statusbericht ── -->
                <Border BackgroundColor="#FFF3CD" StrokeThickness="0" Padding="14,10"
                        IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                    <Label Text="{Binding StatusMessage}"
                           TextColor="#856404"
                           FontSize="13" />
                </Border>

                <!-- ── Opslaan ── -->
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveLessonCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding SaveButtonText}"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Padding="0,16"
                           InputTransparent="True" />
                </Border>

                <!-- ── Lid toevoegen (bewerkingsmodus) ── -->
                <VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="12" Margin="0,8,0,0">
                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />
                    <Label Text="{h:Translate Manage_AddMember}"
                           FontSize="11" FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="{StaticResource Gray500}"
                           Margin="2,0,0,0" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" BackgroundColor="White" StrokeThickness="0" Padding="14,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Entry Placeholder="{h:Translate Manage_UserId}"
                                   Keyboard="Numeric"
                                   Text="{Binding AddMemberInput}"
                                   TextColor="{StaticResource Tertiary}"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   BackgroundColor="Transparent" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0" Padding="16,14">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddMemberCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{h:Translate Manage_Add}"
                                   TextColor="White"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   InputTransparent="True" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading overlay -->
        <BoxView Grid.Row="1"
                 IsVisible="{Binding IsBusy}"
                 InputTransparent="False"
                 Color="Black"
                 Opacity="0.2" />
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>