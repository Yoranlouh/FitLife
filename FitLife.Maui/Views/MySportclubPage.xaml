<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:h="clr-namespace:FitLife.Maui.Helpers"
             x:Class="FitLife.Maui.Views.MySportclubPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Mijn Sportclub">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,8">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Label Text="{h:Translate Sportclub_Title}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18"
                   HorizontalOptions="Center" />
        </Grid>

        <!-- Info balk -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16,12">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.08" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="FitLife"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Tertiary}" />
                    <Label Text="Hogeschoollaan 1, 4818 CR Breda"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        Padding="12,8"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionsTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{h:Translate Sportclub_Directions}"
                           TextColor="White"
                           FontSize="13"
                           FontAttributes="Bold"
                           InputTransparent="True" />
                </Border>
            </Grid>
        </Border>

        <!-- Google Maps WebView -->
        <WebView Grid.Row="2"
                 x:Name="MapView" />

    </Grid>
</ContentPage>