<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:h="clr-namespace:FitLife.Maui.Helpers"
             x:Class="FitLife.Maui.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Text="☰"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    Padding="0"
                    VerticalOptions="Center"
                    Clicked="OnHamburgerClicked"
                    AutomationId="HomeHamburgerBtn" />
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="{h:Translate Home_Title}"
                       Style="{StaticResource HeaderTitle}"
                       FontSize="20" />
            </VerticalStackLayout>
            <Grid Grid.Column="2"
                  VerticalOptions="Center"
                  WidthRequest="44" HeightRequest="44"
                  AutomationId="HomeNotificationBell">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationClicked" />
                </Grid.GestureRecognizers>
                <Image Source="icon_bell.svg"
                       WidthRequest="26" HeightRequest="26"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Border IsVisible="{Binding HasUnread}"
                        BackgroundColor="#E53935"
                        StrokeThickness="0"
                        StrokeShape="Ellipse"
                        WidthRequest="18" HeightRequest="18"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        TranslationX="2" TranslationY="-2">
                    <Label Text="{Binding UnreadCount}"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- Tile grid -->
        <ScrollView Grid.Row="1" BackgroundColor="White">
            <VerticalStackLayout Spacing="0">

                <!-- Logo section -->
                <Grid HeightRequest="160" BackgroundColor="White">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                        <Label Text="FitLife."
                               TextColor="#5B6636"
                               FontSize="42"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               AutomationId="HomeLogo" />
                        <Label Text="{Binding WelcomeMessage}"
                               TextColor="#5B6636"
                               FontSize="14"
                               HorizontalOptions="Center"
                               AutomationId="HomeWelcomeLabel" />
                    </VerticalStackLayout>
                </Grid>

                <!-- ==================== MEMBER TILES ==================== -->
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      IsVisible="{Binding IsMember}"
                      AutomationId="HomeMemberTilesGrid">

                    <!-- Rooster -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200"
                            AutomationId="HomeTileSchedule">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewLessonsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_calendar.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Schedule}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Afspraken & reserveringen -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200"
                            AutomationId="HomeTileReservations">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReservationsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_bookmark.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Reservations}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Profiel -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200"
                            AutomationId="HomeTileProfile">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_profile.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Profile}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Abonnement -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200"
                            AutomationId="HomeTileSubscription">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubscriptionClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_payment.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Subscription}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ==================== TRAINER TILES ==================== -->
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      IsVisible="{Binding IsInstructor}">

                    <!-- Trainer Rooster -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInstructorLessonsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_clipboard.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_TrainerSchedule}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lessen Deelnemen -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReservationsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_bookmark.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_MyLessons}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Les Aanmaken -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateLessonClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_plus.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_CreateLesson}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Rooster bekijken -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewLessonsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_calendar.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Schedule}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Profiel -->
                    <Border Grid.Row="2" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_profile.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Profile}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Abonnement -->
                    <Border Grid.Row="2" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubscriptionClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_payment.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Subscription}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ==================== ADMIN TILES ==================== -->
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      IsVisible="{Binding IsAdmin}">

                    <!-- Les Aanmaken -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateLessonClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_plus.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_CreateLesson}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lessen Beheer -->
                    <Border Grid.Row="0" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewLessonsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_calendar.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_ManageLessons}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Instructeurs -->
                    <Border Grid.Row="1" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_badge.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Instructors}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Leden -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_members.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Members}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Profiel -->
                    <Border Grid.Row="2" Grid.Column="0"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="White" HeightRequest="200">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14">
                            <Image Source="icon_profile.svg" WidthRequest="46" HeightRequest="46" HorizontalOptions="Center" />
                            <Label Text="{h:Translate Home_Profile}"
                                   FontSize="13" TextColor="{StaticResource Black}"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1"
                            Stroke="{StaticResource MediumGray}" StrokeThickness="0.5"
                            BackgroundColor="{StaticResource LightGray}" HeightRequest="200" />
                </Grid>

                <BoxView HeightRequest="60" Color="{StaticResource LightGray}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>