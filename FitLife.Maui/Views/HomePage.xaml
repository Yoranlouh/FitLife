<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             x:Class="FitLife.Maui.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              ColumnDefinitions="Auto,*,Auto">

            <Label Grid.Column="0"
                   Text="☰"
                   TextColor="{StaticResource White}"
                   FontSize="34"
                   VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="FitLife."
                       Style="{StaticResource HeaderTitle}"
                       FontSize="24" />
            </VerticalStackLayout>

            <Label Grid.Column="2"
                   Text="✉"
                   TextColor="{StaticResource White}"
                   FontSize="34"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Tiles -->
        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource LightGray}">
            <VerticalStackLayout Spacing="0">
                <!-- Logo section -->
                <Grid HeightRequest="200" BackgroundColor="White">
                    <Label Text="FitLife" 
                           TextColor="{StaticResource Primary}" 
                           FontSize="48" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Grid>

                <!-- Tiles Grid -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="250">
                    <!-- Rooster & Events -->
                    <Border Grid.Column="0" 
                            Stroke="{StaticResource MediumGray}" 
                            StrokeThickness="1"
                            BackgroundColor="White">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewLessonsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                            <Label Text="📅" FontSize="60" HorizontalOptions="Center" TextColor="{StaticResource Black}" />
                            <Label Text="Rooster &amp; Events" 
                                   FontSize="20" 
                                   TextColor="{StaticResource Black}" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Afspraken & reserveringen -->
                    <Border Grid.Column="1" 
                            Stroke="{StaticResource MediumGray}" 
                            StrokeThickness="1"
                            BackgroundColor="White">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReservationsClicked" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                            <Label Text="✅" FontSize="60" HorizontalOptions="Center" TextColor="{StaticResource Black}" />
                            <Label Text="Afspraken &amp; reserveringen" 
                                   FontSize="20" 
                                   TextColor="{StaticResource Black}" 
                                   HorizontalOptions="Center" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                
                <!-- Placeholder for the rest of the empty space -->
                <BoxView HeightRequest="500" Color="{StaticResource LightGray}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
