<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:controls="clr-namespace:FitLife.Maui.Controls"
             xmlns:h="clr-namespace:FitLife.Maui.Helpers"
             x:Class="FitLife.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,8">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked"
                    AutomationId="ProfileBackBtn" />
            <Label Text="{h:Translate Profile_Title}"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="18"
                   HorizontalOptions="Center" />
        </Grid>
        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Profiel Sectie -->
            <Frame CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Grid HorizontalOptions="Center" WidthRequest="120" HeightRequest="120">
                        <controls:UserAvatarView PhotoUrl="{Binding ProfilePictureUrl}"
                                                AvatarSize="120" />
                        <ActivityIndicator IsRunning="{Binding IsUploadingPhoto}"
                                           IsVisible="{Binding IsUploadingPhoto}"
                                           Color="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding FirstName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           AutomationId="ProfileFirstName" />
                    <Label Text="{Binding LastName}"
                           FontSize="18"
                           HorizontalOptions="Center"
                           AutomationId="ProfileLastName" />

                    <Button Text="{h:Translate Profile_ChangePhoto}"
                            Command="{Binding PickPhotoCommand}"
                            IsEnabled="{Binding IsUploadingPhoto, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,10,0,0"
                            AutomationId="ProfileChangePhotoBtn" />

                    <Button Text="{h:Translate Profile_DeletePhoto}"
                            Command="{Binding DeletePhotoCommand}"
                            IsEnabled="{Binding IsUploadingPhoto, Converter={StaticResource InvertedBoolConverter}}"
                            IsVisible="{Binding ProfilePictureUrl, Converter={StaticResource StringNotEmptyConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="Red"
                            FontSize="13"
                            Margin="0,-6,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Credits & Abonnement (compact) -->
            <Frame CornerRadius="10" Padding="14,12" HasShadow="True" BackgroundColor="{StaticResource Primary}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2" Grid.Column="0" VerticalOptions="Center">
                        <Label Text="{Binding SubscriptionName}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White"
                               AutomationId="ProfileSubscriptionName" />
                        <Label Text="{h:Translate Profile_CreditEqualsLesson}"
                               FontSize="11"
                               TextColor="White"
                               Opacity="0.75" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="1" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="{Binding CreditsDisplay}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="End"
                               AutomationId="ProfileCreditsDisplay" />
                        <Label Text="{h:Translate Profile_Credits}"
                               FontSize="11"
                               TextColor="White"
                               Opacity="0.75"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Abonnement Sectie -->
            <Label Text="{h:Translate Profile_MySubscription}" FontSize="20" FontAttributes="Bold" />
            <Frame CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{h:Translate Profile_Type}" FontAttributes="Bold" />
                        <Label Text="{Binding SubscriptionName}" TextColor="Green" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{h:Translate Profile_RemainingCredits}" FontAttributes="Bold" />
                        <Label Text="{Binding CreditsDisplay}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{h:Translate Profile_Renewal}" FontAttributes="Bold" />
                        <Label Text="{Binding SubscriptionEndDate, StringFormat='{0:dd-MM-yyyy}'}" />
                    </HorizontalStackLayout>

                    <!-- Pending Change Warning -->
                    <Frame IsVisible="{Binding HasPendingSubscriptionChange}"
                           BackgroundColor="Orange"
                           Padding="10"
                           CornerRadius="5"
                           HasShadow="False"
                           Margin="0,5,0,0">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠️"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding PendingSubscriptionInfo}"
                                   FontSize="12"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   HorizontalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                    </Frame>

                    <Button Text="{h:Translate Profile_ManageSubscription}"
                            Clicked="OnManageSubscriptionClicked"
                            Margin="0,10,0,0"
                            AutomationId="ProfileManageSubscriptionBtn" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="{h:Translate Profile_ViewMyLessons}"
                    Clicked="OnViewMyLessonsClicked"
                    AutomationId="ProfileViewMyLessonsBtn" />

            <Button Text="{h:Translate Menu_Logout}"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Red"
                    TextColor="White"
                    Margin="0,20,0,0"
                    AutomationId="ProfileLogoutBtn" />
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
