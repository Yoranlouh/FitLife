<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             x:Class="FitLife.Maui.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="{Binding Title}">
    
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Profiel Sectie -->
            <Frame CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image Source="{Binding ProfilePictureUrl}"
                           HeightRequest="120"
                           WidthRequest="120"
                           Aspect="AspectFill"
                           HorizontalOptions="Center">
                        <Image.Clip>
                            <EllipseGeometry RadiusX="60" RadiusY="60" Center="60,60" />
                        </Image.Clip>
                    </Image>
                    
                    <Label Text="{Binding FirstName}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />
                    <Label Text="{Binding LastName}" 
                           FontSize="18" 
                           HorizontalOptions="Center" />
                    
                    <Button Text="Foto wijzigen" 
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Credits & Abonnement (compact) -->
            <Frame CornerRadius="10" Padding="14,12" HasShadow="True" BackgroundColor="{StaticResource Primary}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2" Grid.Column="0" VerticalOptions="Center">
                        <Label Text="{Binding SubscriptionName}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Text="1 credit = 1 les"
                               FontSize="11"
                               TextColor="White"
                               Opacity="0.75" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="1" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="{Binding CreditsDisplay}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="End" />
                        <Label Text="credits"
                               FontSize="11"
                               TextColor="White"
                               Opacity="0.75"
                               HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- Abonnement Sectie -->
            <Label Text="Mijn Abonnement" FontSize="20" FontAttributes="Bold" />
            <Frame CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Type:" FontAttributes="Bold" />
                        <Label Text="{Binding SubscriptionName}" TextColor="Green" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Vernieuwing:" FontAttributes="Bold" />
                        <Label Text="{Binding SubscriptionEndDate, StringFormat='{0:dd-MM-yyyy}'}" />
                    </HorizontalStackLayout>

                    <!-- Pending Change Warning -->
                    <Frame IsVisible="{Binding HasPendingSubscriptionChange}"
                           BackgroundColor="Orange"
                           Padding="10"
                           CornerRadius="5"
                           HasShadow="False"
                           Margin="0,5,0,0">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="⚠️"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding PendingSubscriptionInfo}"
                                   FontSize="12"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   LineBreakMode="WordWrap"
                                   HorizontalOptions="FillAndExpand" />
                        </HorizontalStackLayout>
                    </Frame>

                    <Button Text="Abonnement Beheren"
                            Clicked="OnManageSubscriptionClicked"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Mijn Lessen Bekijken" 
                    Clicked="OnViewMyLessonsClicked" />

            <Button Text="Uitloggen"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="Red"
                    TextColor="White"
                    Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
