<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:models="clr-namespace:SharedLibrary.DTOs.Responses;assembly=SharedLibrary"
             x:Class="FitLife.Maui.Views.WeekPage"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:WeekViewModel">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Header -->
        <Grid Grid.Row="0" Style="{StaticResource HeaderGrid}" ColumnDefinitions="Auto, *, Auto" Padding="10, 5">
            <ImageButton Source="back_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
            <StackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="Crossfit FitLife." Style="{StaticResource HeaderTitle}" FontSize="14"/>
                <Label Text="- Selecteer ander rooster -" Style="{StaticResource HeaderSubtitle}" FontSize="10"/>
            </StackLayout>
            <ImageButton Grid.Column="2" Source="calendar_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
        </Grid>

        <!-- View Selector -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource Black}" Padding="10, 10" ColumnDefinitions="*, *">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Image Source="calendar_small.png" WidthRequest="15" HeightRequest="15"/>
                <Label Text="Kalenderweergave" TextColor="{StaticResource White}" VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                <Image Source="list_icon.png" WidthRequest="15" HeightRequest="15"/>
                <Label Text="Lijstweergave" TextColor="{StaticResource White}" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Week Navigation -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource Black}" Padding="10, 10" ColumnDefinitions="Auto, *, Auto">
            <Button Text="◀" TextColor="{StaticResource White}" BackgroundColor="Transparent" Command="{Binding PreviousWeekCommand}"/>
            <Label Grid.Column="1" Text="{Binding WeekRangeText}" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="▶" TextColor="{StaticResource White}" BackgroundColor="Transparent" Command="{Binding NextWeekCommand}"/>
        </Grid>

                <!-- Main Content -->
        <ScrollView Grid.Row="3">
            <Grid ColumnDefinitions="50, *" RowDefinitions="Auto, *">
                
                <!-- Top-left corner: Info button -->
                <Border Grid.Row="0" Grid.Column="0" 
                        Stroke="{StaticResource Gray200}" 
                        StrokeThickness="0.5"
                        BackgroundColor="{StaticResource White}"
                        HeightRequest="50">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowLegendCommand}" />
                    </Border.GestureRecognizers>
                    <Frame WidthRequest="28" 
                           HeightRequest="28" 
                           CornerRadius="14" 
                           BorderColor="{StaticResource Black}" 
                           BackgroundColor="Transparent"
                           Padding="0"
                           HasShadow="False"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           InputTransparent="True">
                        <Label Text="i" 
                               FontSize="16" 
                               FontAttributes="Italic"
                               TextColor="{StaticResource Black}"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               InputTransparent="True"/>
                    </Frame>
                </Border>

                <!-- Day Headers -->
                <FlexLayout Grid.Column="1" Grid.Row="0"
                           Direction="Row"
                           JustifyContent="SpaceEvenly"
                           BackgroundColor="{StaticResource White}"
                           HeightRequest="50">
                    <BindableLayout.ItemsSource>
                        <Binding Path="WeekDays" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayHeaderViewModel">
                            <Border Stroke="{StaticResource Gray200}"
                                    StrokeThickness="0.5"
                                    HorizontalOptions="FillAndExpand"
                                    VerticalOptions="FillAndExpand"
                                    WidthRequest="50">
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Padding="0,10"
                                                     Spacing="2">
                                    <Label Text="{Binding DayName}"
                                           FontSize="10"
                                           TextColor="{StaticResource Black}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding DayNumber}"
                                           FontSize="12"
                                           TextColor="{StaticResource Black}"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Grid Body - Time column + 7 equal day columns -->
                <Grid x:Name="LessonGrid"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="50,*,*,*,*,*,*,*"
                      RowDefinitions="50,50,50,50,50,50,50,50,50,50,50,50"
                      BackgroundColor="#e8e8e8">

                    <!-- Static background borders (veel sneller dan code-behind) -->
                    <BoxView Grid.Column="1" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />
                    <BoxView Grid.Column="2" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />
                    <BoxView Grid.Column="3" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />
                    <BoxView Grid.Column="4" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />
                    <BoxView Grid.Column="5" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />
                    <BoxView Grid.Column="6" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />
                    <BoxView Grid.Column="7" Grid.RowSpan="12" BackgroundColor="#e8e8e8" />

                    <!-- Lesson items will be added dynamically here -->
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>