<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:models="clr-namespace:SharedLibrary.DTOs.Responses;assembly=SharedLibrary"
             x:Class="FitLife.Maui.Views.WeekPage"
             Title="{Binding Title}"
             x:DataType="vm:WeekViewModel">

    <Grid RowDefinitions="Auto, *">
        <Button Text="Refresh" Command="{Binding LoadLessonsCommand}" Grid.Row="0" Margin="10"/>
        
        <CollectionView Grid.Row="1" ItemsSource="{Binding Lessons}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LessonResponse">
                    <Frame Margin="10" Padding="15" HasShadow="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=GoToDetailsCommand}" 
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                        <StackLayout>
                            <Label Text="{Binding WorkoutName}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding StartTime, StringFormat='{0:dddd dd MMMM HH:mm}'}" />
                            <Label Text="{Binding InstructorName}" FontAttributes="Italic" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
