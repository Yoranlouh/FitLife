<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:svc="clr-namespace:FitLife.Maui.Services"
             x:Class="FitLife.Maui.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}">
            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Label Text="Notificaties"
                   Style="{StaticResource HeaderTitle}"
                   FontSize="20"
                   HorizontalOptions="Center" />
            <Button Text="Alles gelezen"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="12"
                    HorizontalOptions="End"
                    Command="{Binding ClearAllCommand}" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource White}">

            <!-- Empty state -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="14">
                <Label Text="🔔"
                       FontSize="52"
                       HorizontalOptions="Center" />
                <Label Text="Geen notificaties"
                       FontSize="16"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
                <Label Text="Hier zie je je meldingen zodra ze binnenkomen."
                       FontSize="13"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="30,0" />
            </VerticalStackLayout>

            <!-- Notification list -->
            <CollectionView ItemsSource="{Binding Items}"
                            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="svc:AppNotification">
                        <Grid ColumnDefinitions="Auto, *"
                              Padding="16,12"
                              ColumnSpacing="14">

                            <!-- Type kleurbol met icon -->
                            <Border Grid.Column="0"
                                    WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding TypeColor}"
                                    StrokeShape="Ellipse"
                                    VerticalOptions="Start"
                                    Margin="0,2,0,0">
                                <Label Text="{Binding TypeIcon}"
                                       TextColor="White"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Inhoud -->
                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="3">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="{StaticResource Black}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding TimeDisplay}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center"
                                           Margin="6,0,0,0" />
                                </Grid>
                                <Label Text="{Binding Message}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray600}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>