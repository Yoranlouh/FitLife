<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:models="clr-namespace:SharedLibrary.DTOs.Responses;assembly=SharedLibrary"
           xmlns:converters="clr-namespace:FitLife.Maui.Converters"
           x:Class="FitLife.Maui.Views.MultipleLessonsPopup"
           x:TypeArguments="models:LessonResponse"
           Color="Transparent">

    <toolkit:Popup.Resources>
        <converters:WorkoutColorConverter x:Key="WorkoutColorConverter" />
        <converters:IntegerToBoolConverter x:Key="IntegerToBoolConverter" />
    </toolkit:Popup.Resources>

    <Border StrokeShape="RoundRectangle 20,20,0,0"
            BackgroundColor="White"
            VerticalOptions="End"
            MaximumHeightRequest="600"
            Padding="20">
        <VerticalStackLayout Spacing="10">
            <!-- Handle indicator for sliding feel -->
            <BoxView HeightRequest="4" 
                     WidthRequest="40" 
                     CornerRadius="2" 
                     BackgroundColor="{StaticResource Gray200}" 
                     HorizontalOptions="Center"
                     Margin="0,0,0,10"/>

            <CollectionView x:Name="LessonsListView"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LessonResponse">
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,15" RowDefinitions="Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLessonTapped" CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <!-- Left Color Block with Participant Count -->
                            <Border Grid.Column="0" 
                                    WidthRequest="60" 
                                    HeightRequest="60" 
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding WorkoutColor, Converter={StaticResource WorkoutColorConverter}}">
                                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                                        <Label Text="{Binding CurrentParticipantCount}" 
                                               TextColor="White" 
                                               FontSize="12" 
                                               FontAttributes="Bold"/>
                                        <Label Text="/" 
                                               TextColor="White" 
                                               FontSize="12"/>
                                        <Label Text="{Binding MaxParticipants}" 
                                               TextColor="White" 
                                               FontSize="12"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding WaitlistCount, StringFormat='+{0}'}"
                                           TextColor="White"
                                           FontSize="10"
                                           HorizontalOptions="Center"
                                           IsVisible="{Binding WaitlistCount, Converter={StaticResource IntegerToBoolConverter}}"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Middle Info Section -->
                            <VerticalStackLayout Grid.Column="1" Margin="15,0" Spacing="2">
                                <HorizontalStackLayout Spacing="10">
                                    <Label FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="Black">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0:HH:mm} - {1:HH:mm}">
                                                <Binding Path="StartTime" />
                                                <Binding Path="EndTime" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    
                                    <Border BackgroundColor="{Binding WorkoutColor, Converter={StaticResource WorkoutColorConverter}}"
                                            Padding="8,2"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 5">
                                        <Label Text="{Binding WorkoutName}"
                                               FontSize="10"
                                               TextColor="White"/>
                                    </Border>
                                </HorizontalStackLayout>
                                
                                <Label Text="{Binding InstructorName}" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Gray600}"/>
                                
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                    <Label Text="{Binding LocationName}" 
                                           FontSize="12" 
                                           TextColor="{StaticResource Gray500}"
                                           LineBreakMode="TailTruncation"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Right Arrow -->
                            <Label Grid.Column="2" 
                                   Text="›" 
                                   FontSize="24" 
                                   TextColor="{StaticResource Gray400}" 
                                   VerticalOptions="Center"/>
                            
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
