<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
               x:Class="FitLife.Maui.Views.LegendPopup"
               Color="Transparent">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 16"
            Padding="20"
            WidthRequest="340">
        <VerticalStackLayout Spacing="16">

            <!-- Status row -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,10">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="✓" FontSize="18"/>
                        <Label Text="Aangemeld" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,10">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="W" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="Op wachtlijst" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Workout types - dynamic based on current week's lessons -->
            <FlexLayout BindableLayout.ItemsSource="{Binding Items}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="SpaceBetween">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkoutLegendItem">
                        <HorizontalStackLayout Spacing="8" Margin="0,0,0,10" WidthRequest="140">
                            <BoxView WidthRequest="22"
                                     HeightRequest="22"
                                     CornerRadius="3"
                                     Color="{Binding Color, Converter={StaticResource WorkoutColorConverter}}" />
                            <Label Text="{Binding Name}"
                                   VerticalOptions="Center"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   MaximumWidthRequest="108" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>