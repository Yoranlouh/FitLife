<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:responses="clr-namespace:SharedLibrary.DTOs.Responses;assembly=SharedLibrary"
             x:Class="FitLife.Maui.Views.LessonsPage"
             x:Name="LessonsRoot"
             x:DataType="vm:LessonsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto">

            <Label Grid.RowSpan="2"
                   Grid.Column="0"
                   Text="‹"
                   TextColor="{StaticResource White}"
                   FontSize="56"
                   VerticalOptions="Center"
                   HorizontalOptions="Start" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="Crossfit FitLife"
                       Style="{StaticResource HeaderTitle}" />
                <Label Text="- Selecteer ander rooster -"
                       Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>

            <Label Grid.RowSpan="2"
                   Grid.Column="2"
                   Text="▣"
                   TextColor="{StaticResource White}"
                   FontSize="34"
                   VerticalOptions="Center"
                   HorizontalOptions="End" />
        </Grid>

        <!-- View switch -->
        <Grid Grid.Row="1"
              HeightRequest="72"
              ColumnDefinitions="*,*">
            <Grid Grid.Column="0"
                  BackgroundColor="{StaticResource MediumGray}"
                  Padding="18,0">
                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <Label Text="▣"
                           TextColor="{StaticResource Black}"
                           FontSize="24"
                           VerticalOptions="Center" />
                    <Label Text="Kalenderweergave"
                           TextColor="{StaticResource Black}"
                           FontSize="22"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Column="1"
                  BackgroundColor="{StaticResource LightGray}"
                  Padding="18,0">
                <HorizontalStackLayout Spacing="12"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <Label Text="≡"
                           TextColor="{StaticResource Black}"
                           FontSize="28"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label Text="Lijstweergave"
                           TextColor="{StaticResource Black}"
                           FontSize="22"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- Week selector -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource Black}"
              HeightRequest="76"
              ColumnDefinitions="Auto,*,Auto"
              Padding="28,0">
            <Label Grid.Column="0"
                   Text="‹"
                   TextColor="{StaticResource White}"
                   FontSize="34"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Week 18, april 2026"
                   TextColor="{StaticResource White}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="›"
                   TextColor="{StaticResource White}"
                   FontSize="34"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Days -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource White}"
              Padding="16,18,16,20"
              ColumnDefinitions="*,*,*,*,*,*,*">
            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Label Text="MA" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                <Label Text="27" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Label Text="DI" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                <Label Text="28" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource Secondary}"
                    StrokeThickness="0"
                    Padding="22,10"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="WO" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                    <Label Text="29" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                <Label Text="DO" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                <Label Text="30" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                <Label Text="VR" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                <Label Text="1" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="5" Spacing="2" HorizontalOptions="Center">
                <Label Text="ZA" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                <Label Text="2" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="6" Spacing="2" HorizontalOptions="Center">
                <Label Text="ZO" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
                <Label Text="3" FontSize="18" TextColor="{StaticResource DarkGray}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Lesson list -->
        <Grid Grid.Row="4"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource White}">

            <Grid Grid.Row="0"
                  Style="{StaticResource SectionHeaderGrid}">
                <Label Text="woensdag, 29 apr. 2026"
                       Style="{StaticResource SectionHeaderText}" />
            </Grid>

            <RefreshView Grid.Row="1"
                         Command="{Binding LoadLessonsCommand}"
                         IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Lessons}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="responses:LessonResponse">
                            <Grid Padding="0"
                                  BackgroundColor="{StaticResource White}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LessonsViewModel}}, Path=GoToDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Grid Padding="24,22"
                                      ColumnDefinitions="98,*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="24">

                                    <!-- Capacity block -->
                                    <Border Grid.RowSpan="3"
                                            Grid.Column="0"
                                            WidthRequest="98"
                                            HeightRequest="98"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label Text="11 / 12"
                                               TextColor="{StaticResource White}"
                                               FontSize="25"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Time and workout -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Grid.Row="0"
                                                           Spacing="14">
                                        <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="28"
                                               VerticalOptions="Center" />

                                        <Label Text=" - "
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="28"
                                               VerticalOptions="Center" />

                                        <Label Text="{Binding EndTime, StringFormat='{0:HH:mm}'}"
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="28"
                                               VerticalOptions="Center" />

                                        <Border BackgroundColor="{StaticResource Secondary}"
                                                StrokeThickness="0"
                                                Padding="11,4"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="9" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding WorkoutName}"
                                                   TextColor="{StaticResource Tertiary}"
                                                   FontSize="20"
                                                   CharacterSpacing="2" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Instructor -->
                                    <Label Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{Binding InstructorName}"
                                           TextColor="{StaticResource OffBlack}"
                                           FontSize="22"
                                           Margin="0,4,0,0" />

                                    <!-- Location -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Grid.Row="2"
                                                           Spacing="8"
                                                           Margin="0,8,0,0">
                                        <Label Text="●"
                                               TextColor="{StaticResource DarkGray}"
                                               FontSize="18"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding LocationName}"
                                               TextColor="{StaticResource DarkGray}"
                                               FontSize="18"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Arrow -->
                                    <Label Grid.Column="2"
                                           Grid.RowSpan="3"
                                           Text="›"
                                           TextColor="{StaticResource Black}"
                                           FontSize="42"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="{StaticResource SeparatorGray}"
                                         VerticalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="12"
                                             Padding="24">
                            <Label Text="Geen lessen gevonden"
                                   TextColor="{StaticResource Black}"
                                   FontSize="18"
                                   HorizontalOptions="Center" />
                            <Button Text="Vernieuwen"
                                    Command="{Binding LoadLessonsCommand}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <ActivityIndicator Grid.RowSpan="5"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
