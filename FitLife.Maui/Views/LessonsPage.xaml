<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:responses="clr-namespace:SharedLibrary.DTOs.Responses;assembly=SharedLibrary"
             x:Class="FitLife.Maui.Views.LessonsPage"
             x:Name="LessonsRoot"
             x:DataType="vm:LessonsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              ColumnDefinitions="Auto,*,Auto"
              Padding="10,5">

            <ImageButton Source="back_icon.png"
                         WidthRequest="20"
                         HeightRequest="20"
                         VerticalOptions="Center">
                <ImageButton.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToWeekViewCommand}" />
                </ImageButton.GestureRecognizers>
            </ImageButton>

            <StackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="Crossfit FitLife."
                       Style="{StaticResource HeaderTitle}"
                       FontSize="14" />
                <Label Text="- Selecteer ander rooster -"
                       Style="{StaticResource HeaderSubtitle}"
                       FontSize="10" />
            </StackLayout>

            <ImageButton Grid.Column="2"
                         Source="calendar_icon.png"
                         WidthRequest="20"
                         HeightRequest="20"
                         VerticalOptions="Center" />
        </Grid>

        <!-- View Selector -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource Black}"
              Padding="10,10"
              ColumnDefinitions="*,*">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToWeekViewCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="calendar_small.png" WidthRequest="15" HeightRequest="15"/>
                <Label Text="Kalenderweergave"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                <Image Source="list_icon.png" WidthRequest="15" HeightRequest="15"/>
                <Label Text="Lijstweergave"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Week Navigation -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource Black}"
              Padding="10,10"
              ColumnDefinitions="Auto,*,Auto">
            <Button Text="◀"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    Command="{Binding PreviousWeekCommand}"/>
            <Label Grid.Column="1"
                   Text="{Binding WeekRangeText}"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Button Grid.Column="2"
                    Text="▶"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    Command="{Binding NextWeekCommand}"/>
        </Grid>

        <!-- Days - Dynamic binding -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding WeekDays}"
                        SelectionMode="None"
                        HeightRequest="50"
                        BackgroundColor="{StaticResource White}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Horizontal" Span="1" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DayHeaderViewModel">
                    <Border WidthRequest="50"
                            Margin="2,4"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"
                            StrokeThickness="0"
                            Padding="4,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LessonsViewModel}}, Path=SelectDayCommand}"
                                CommandParameter="{Binding Date}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding DayName}"
                                   FontSize="10"
                                   TextColor="{StaticResource DarkGray}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding DayNumber}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DarkGray}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Lesson list -->
        <Grid Grid.Row="4"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource White}">

            <Grid Grid.Row="0"
                  Style="{StaticResource SectionHeaderGrid}">
                <Label Text="{Binding SelectedDateText}"
                       Style="{StaticResource SectionHeaderText}" />
            </Grid>

            <RefreshView Grid.Row="1"
                         Command="{Binding LoadLessonsCommand}"
                         IsRefreshing="{Binding IsBusy}">
                <CollectionView ItemsSource="{Binding Lessons}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="responses:LessonResponse">
                            <Grid Padding="0"
                                  BackgroundColor="{StaticResource White}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LessonsViewModel}}, Path=GoToDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Grid Padding="12,10"
                                      ColumnDefinitions="60,*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="12">

                                    <!-- Capacity block -->
                                    <Border Grid.RowSpan="3"
                                            Grid.Column="0"
                                            WidthRequest="60"
                                            HeightRequest="60"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label Text="11 / 12"
                                               TextColor="{StaticResource White}"
                                               FontSize="14"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Time and workout -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Grid.Row="0"
                                                           Spacing="6">
                                        <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="16"
                                               VerticalOptions="Center" />

                                        <Label Text=" - "
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="16"
                                               VerticalOptions="Center" />

                                        <Label Text="{Binding EndTime, StringFormat='{0:HH:mm}'}"
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="16"
                                               VerticalOptions="Center" />

                                        <Border BackgroundColor="{StaticResource Secondary}"
                                                StrokeThickness="0"
                                                Padding="6,2"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding WorkoutName}"
                                                   TextColor="{StaticResource Tertiary}"
                                                   FontSize="12"
                                                   CharacterSpacing="1" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Instructor -->
                                    <Label Grid.Column="1"
                                           Grid.Row="1"
                                           Text="{Binding InstructorName}"
                                           TextColor="{StaticResource OffBlack}"
                                           FontSize="14"
                                           Margin="0,2,0,0" />

                                    <!-- Location -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Grid.Row="2"
                                                           Spacing="4"
                                                           Margin="0,4,0,0">
                                        <Label Text="●"
                                               TextColor="{StaticResource DarkGray}"
                                               FontSize="10"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding LocationName}"
                                               TextColor="{StaticResource DarkGray}"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <!-- Arrow -->
                                    <Label Grid.Column="2"
                                           Grid.RowSpan="3"
                                           Text="›"
                                           TextColor="{StaticResource Black}"
                                           FontSize="24"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="{StaticResource SeparatorGray}"
                                         VerticalOptions="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8"
                                             Padding="12">
                            <Label Text="Geen lessen gevonden"
                                   TextColor="{StaticResource Black}"
                                   FontSize="14"
                                   HorizontalOptions="Center" />
                            <Button Text="Vernieuwen"
                                    Command="{Binding LoadLessonsCommand}"
                                    FontSize="12"
                                    Padding="8,4" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <ActivityIndicator Grid.RowSpan="5"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
