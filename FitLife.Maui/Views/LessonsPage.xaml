<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitLife.Maui.ViewModels"
             xmlns:responses="clr-namespace:SharedLibrary.DTOs.Responses;assembly=SharedLibrary"
             x:Class="FitLife.Maui.Views.LessonsPage"
             x:Name="LessonsRoot"
             x:DataType="vm:LessonsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              Padding="10,5">

            <Button Text="&lt;"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    FontSize="24"
                    FontAttributes="Bold"
                    Padding="0"
                    VerticalOptions="Center"
                    WidthRequest="44"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />

            <StackLayout HorizontalOptions="Center">
                <Label Text="FitLife"
                       Style="{StaticResource HeaderTitle}"
                       FontSize="14" />
            </StackLayout>

            <ImageButton Source="calendar_icon.png"
                         WidthRequest="20"
                         HeightRequest="20"
                         VerticalOptions="Center"
                         HorizontalOptions="End" />
        </Grid>

        <!-- View Selector -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource Black}"
              Padding="10,10"
              ColumnDefinitions="*,*">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToWeekViewCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Image Source="calendar_small.png" WidthRequest="15" HeightRequest="15"/>
                <Label Text="Kalenderweergave"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                <Image Source="list_icon.png" WidthRequest="15" HeightRequest="15"/>
                <Label Text="Lijstweergave"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Week Navigation -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource Black}"
              Padding="10,10"
              ColumnDefinitions="Auto,*,Auto">
            <Button Text="◀"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    Command="{Binding PreviousWeekCommand}"/>
            <Label Grid.Column="1"
                   Text="{Binding WeekRangeText}"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Button Grid.Column="2"
                    Text="▶"
                    TextColor="{StaticResource White}"
                    BackgroundColor="Transparent"
                    Command="{Binding NextWeekCommand}"/>
        </Grid>

        <!-- Days - Horizontal scrollable week day selector -->
        <!-- Each day is tappable to filter lessons -->
        <ScrollView Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="{StaticResource White}"
                    HeightRequest="70">
            <FlexLayout x:Name="DayHeadersContainer"
                        BindableLayout.ItemsSource="{Binding WeekDays}"
                        Direction="Row"
                        JustifyContent="SpaceEvenly"
                        Padding="10,10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayHeaderViewModel">
                        <!-- Day button with tap gesture -->
                        <Border WidthRequest="55"
                                HeightRequest="50"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"
                                StrokeThickness="0"
                                Margin="4,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True">
                                <VerticalStackLayout Spacing="2"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   InputTransparent="True">
                                    <Label Text="{Binding DayName}"
                                           FontSize="10"
                                           TextColor="{StaticResource DarkGray}"
                                           HorizontalTextAlignment="Center"
                                           InputTransparent="True" />
                                    <Label Text="{Binding DayNumber}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource DarkGray}"
                                           HorizontalTextAlignment="Center"
                                           InputTransparent="True" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </ScrollView>

        <!-- Lesson list - Each lesson item is tappable to navigate to detail page -->
        <Grid Grid.Row="4"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource White}">

            <!-- Selected date header -->
            <Grid Grid.Row="0"
                  Style="{StaticResource SectionHeaderGrid}">
                <Label Text="{Binding SelectedDateText}"
                       Style="{StaticResource SectionHeaderText}" />
            </Grid>

            <!-- Lessons CollectionView with pull-to-refresh -->
            <RefreshView Grid.Row="1"
                         Command="{Binding LoadLessonsCommand}"
                         IsRefreshing="{Binding IsBusy}">
                <CollectionView x:Name="LessonsCollectionView"
                                ItemsSource="{Binding Lessons}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="responses:LessonResponse">
                            <!-- Single Grid with tap gesture -->
                            <Grid Padding="12,10"
                                  BackgroundColor="Transparent"
                                  ColumnDefinitions="60,*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLessonTapped" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <!-- Capacity block - displays current/max participants with workout color -->
                                <Border Grid.RowSpan="3"
                                        Grid.Column="0"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        BackgroundColor="{Binding WorkoutColor, Converter={StaticResource WorkoutColorConverter}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center"
                                        InputTransparent="True">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label TextColor="{StaticResource White}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           InputTransparent="True">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CurrentParticipantCount}" />
                                                <Span Text=" / " />
                                                <Span Text="{Binding MaxParticipants}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Border>

                                <!-- Time and workout name -->
                                <HorizontalStackLayout Grid.Column="1"
                                                       Grid.Row="0"
                                                       Spacing="6"
                                                       InputTransparent="True">
                                    <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                           TextColor="{StaticResource Tertiary}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />

                                    <Label Text=" - "
                                           TextColor="{StaticResource Tertiary}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />

                                    <Label Text="{Binding EndTime, StringFormat='{0:HH:mm}'}"
                                           TextColor="{StaticResource Tertiary}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />

                                    <Border BackgroundColor="{StaticResource Secondary}"
                                            StrokeThickness="0"
                                            Padding="6,2"
                                            VerticalOptions="Center"
                                            InputTransparent="True">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding WorkoutName}"
                                               TextColor="{StaticResource Tertiary}"
                                               FontSize="12"
                                               CharacterSpacing="1"
                                               InputTransparent="True" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Instructor name -->
                                <Label Grid.Column="1"
                                       Grid.Row="1"
                                       Text="{Binding InstructorName}"
                                       TextColor="{StaticResource OffBlack}"
                                       FontSize="14"
                                       Margin="0,2,0,0"
                                       InputTransparent="True" />

                                <!-- Location -->
                                <HorizontalStackLayout Grid.Column="1"
                                                       Grid.Row="2"
                                                       Spacing="4"
                                                       Margin="0,4,0,0"
                                                       InputTransparent="True">
                                    <Label Text="●"
                                           TextColor="{StaticResource DarkGray}"
                                           FontSize="10"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />
                                    <Label Text="{Binding LocationName}"
                                           TextColor="{StaticResource DarkGray}"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center"
                                           InputTransparent="True" />
                                </HorizontalStackLayout>

                                <!-- Arrow icon indicating tappable item -->
                                <Label Grid.Column="2"
                                       Grid.RowSpan="3"
                                       Text="›"
                                       TextColor="{StaticResource Black}"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       InputTransparent="True" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Empty state - shown when no lessons found for selected day -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="8"
                                             Padding="12">
                            <Label Text="Geen lessen gevonden"
                                   TextColor="{StaticResource Black}"
                                   FontSize="14"
                                   HorizontalOptions="Center" />
                            <Button Text="Vernieuwen"
                                    Command="{Binding LoadLessonsCommand}"
                                    FontSize="12"
                                    Padding="8,4" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Loading indicator - shown while loading lessons -->
        <ActivityIndicator Grid.RowSpan="5"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
