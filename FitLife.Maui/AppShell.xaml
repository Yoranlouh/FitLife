<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FitLife.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FitLife.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="FitLife">

    <TabBar>
        <Tab Title="Home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate views:HomePage}"
                Route="HomePage" />
        </Tab>
        <Tab Title="Week">
            <ShellContent
                Title="Weekoverzicht"
                ContentTemplate="{DataTemplate views:WeekPage}"
                Route="WeekPage" />
        </Tab>
        <Tab Title="Lessen">
            <ShellContent
                Title="Lessen"
                ContentTemplate="{DataTemplate views:LessonsPage}"
                Route="LessonsPage" />
        </Tab>
        <Tab Title="Profiel">
            <ShellContent
                Title="Profiel"
                ContentTemplate="{DataTemplate views:ProfilePage}"
                Route="ProfilePage" />
        </Tab>
        <Tab Title="Mijn Lessen">
            <ShellContent
                Title="Mijn Lessen"
                ContentTemplate="{DataTemplate views:MyLessonsPage}"
                Route="MyLessonsPage" />
        </Tab>
        <Tab Title="Deelnemers">
            <ShellContent
                Title="Deelnemers"
                ContentTemplate="{DataTemplate views:InstructorParticipantListPage}"
                Route="InstructorParticipantListPage" />
        </Tab>
    </TabBar>

</Shell>
