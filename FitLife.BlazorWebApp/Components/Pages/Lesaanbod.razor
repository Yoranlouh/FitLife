@page "/lesaanbod"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IWorkoutService WorkoutService

<PageTitle>Lesaanbod - FitLife</PageTitle>

<div class="container mt-5">
    <h2 class="text-center mb-4">Ons Lesaanbod</h2>
    <p class="text-center">Kies uit een breed scala aan lessen die passen bij jouw fitnessdoelen.</p>

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laden...</span>
            </div>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger text-center mt-4">@errorMessage</div>
    }
    else if (workouts.Count == 0)
    {
        <p class="text-center text-muted mt-4">Geen lessen beschikbaar.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-3">
            @foreach (var workout in workouts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">@workout.Name</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">@workout.Description</p>
                            <ul class="list-unstyled">
                                <li><i class="bi bi-calendar-event"></i> Dagelijks beschikbaar</li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<WorkoutDto> workouts = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            workouts = await WorkoutService.GetAllWorkoutsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Er is een fout opgetreden bij het laden van het lesaanbod.";
        }
        finally
        {
            isLoading = false;
        }
    }
}