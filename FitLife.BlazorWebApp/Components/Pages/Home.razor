@page "/"

<PageTitle>Home - FitLife</PageTitle>

<div class="container mt-5">
    <div class="jumbotron text-center bg-light p-5 rounded shadow">
        <h1 class="display-4">Welkom bij FitLife!</h1>
        <p class="lead">Jouw reis naar een gezonder en fitter leven begint hier.</p>
        <hr class="my-4">
        <p>Ontdek ons uitgebreide lesaanbod, van Yoga tot Spinning, en vind het abonnement dat bij jou past.</p>
        <div class="d-grid gap-2 d-md-block">
            <a class="btn btn-primary btn-lg" href="lesaanbod" role="button">Bekijk Lesaanbod</a>
            <a class="btn btn-outline-success btn-lg" href="lid-worden" role="button">Word nu Lid!</a>
        </div>
    </div>

    <div class="row mt-5 text-center">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-calendar-check display-1 text-primary"></i>
                    <h5 class="card-title mt-3">Flexibele Lessen</h5>
                    <p class="card-text">Boek eenvoudig je favoriete lessen via onze website of app.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-people-fill display-1 text-primary"></i>
                    <h5 class="card-title mt-3">Expert Coaches</h5>
                    <p class="card-text">Onze gecertificeerde instructeurs helpen je jouw doelen te bereiken.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="bi bi-shield-check display-1 text-primary"></i>
                    <h5 class="card-title mt-3">Moderne Faciliteiten</h5>
                    <p class="card-text">Train met de nieuwste apparatuur in een veilige en schone omgeving.</p>
                </div>
            </div>
        </div>
    </div>
</div>
