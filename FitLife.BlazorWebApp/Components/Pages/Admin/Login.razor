@page "/admin/login"
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Login - FitLife Admin</PageTitle>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold">FitLife Admin</h2>
                        <p class="text-muted">Login voor Admins en Instructeurs</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                    }

                    <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText @bind-Value="_loginModel.Email"
                                       class="form-control"
                                       id="email"
                                       placeholder="naam@fitlife.nl" />
                            <ValidationMessage For="@(() => _loginModel.Email)" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Wachtwoord</label>
                            <InputText @bind-Value="_loginModel.Password"
                                       type="password"
                                       class="form-control"
                                       id="password"
                                       placeholder="Wachtwoord" />
                            <ValidationMessage For="@(() => _loginModel.Password)" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Inloggen
                            </button>
                        </div>
                    </EditForm>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            Alleen voor medewerkers · <a href="/">Terug naar website</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel _loginModel { get; set; } = new();

    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            NavigationManager.NavigateTo(role == "instructor" ? "/instructor/dashboard" : "/admin/dashboard");
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = string.Empty;

        var (success, message, user) = await AuthService.LoginAsync(_loginModel.Email, _loginModel.Password);

        if (success && user != null)
        {
            NavigationManager.NavigateTo(
                user.Role == "instructor" ? "/instructor/dashboard" : "/admin/dashboard",
                forceLoad: true);
        }
        else
        {
            _errorMessage = message;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Email is verplicht")]
        [EmailAddress(ErrorMessage = "Ongeldig email adres")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Wachtwoord is verplicht")]
        [MinLength(3, ErrorMessage = "Wachtwoord moet minimaal 3 tekens bevatten")]
        public string Password { get; set; } = string.Empty;
    }
}