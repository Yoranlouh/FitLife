@page "/admin/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "employee,instructor")]
@inject IDashboardService DashboardService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <!-- Header with welcome message -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">Dashboard</h1>
            <p class="text-muted">Welkom terug, @_displayName</p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laden...</span>
            </div>
            <p class="mt-3 text-muted">Dashboard gegevens laden...</p>
        </div>
    }
    else if (_stats != null)
    {
        <!-- Statistics Cards Row -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-primary shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Leden</h6>
                                <h2 class="card-title fw-bold mb-0">@_stats.TotalMembers</h2>
                            </div>
                            <i class="bi bi-people-fill fs-1 text-primary opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Instructeurs</h6>
                                <h2 class="card-title fw-bold mb-0">@_stats.TotalInstructors</h2>
                            </div>
                            <i class="bi bi-person-badge-fill fs-1 text-success opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-warning shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Lessen deze week</h6>
                                <h2 class="card-title fw-bold mb-0">@_stats.TotalLessonsThisWeek</h2>
                            </div>
                            <i class="bi bi-calendar-week-fill fs-1 text-warning opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-info shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Gem. Bezetting</h6>
                                <h2 class="card-title fw-bold mb-0">@($"{_stats.AverageOccupancyPercentage:F1}%")</h2>
                            </div>
                            <i class="bi bi-graph-up fs-1 text-info opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Today's Lessons and Popular Workouts Row -->
        <div class="row g-3 mb-4">
            <!-- Today's Lessons -->
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Lessen vandaag (@_stats.TodaysLessons.Count)</h5>
                    </div>
                    <div class="card-body">
                        @if (_stats.TodaysLessons.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Tijd</th>
                                            <th>Workout</th>
                                            <th>Instructeur</th>
                                            <th>Locatie</th>
                                            <th>Bezetting</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lesson in _stats.TodaysLessons)
                                        {
                                            <tr>
                                                <td>@lesson.StartTime.ToString("HH:mm")</td>
                                                <td><strong>@lesson.WorkoutName</strong></td>
                                                <td>@lesson.InstructorName</td>
                                                <td>@lesson.LocationName</td>
                                                <td>
                                                    <span class="badge @GetOccupancyBadgeClass(lesson.OccupancyPercentage)">
                                                        @lesson.CurrentParticipants/@lesson.MaxParticipants (@($"{lesson.OccupancyPercentage:F0}%"))
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center my-4">Geen lessen vandaag.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Popular Workouts -->
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-fire me-2"></i>Populaire Workouts</h5>
                    </div>
                    <div class="card-body">
                        @if (_stats.PopularWorkouts.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var workout in _stats.PopularWorkouts)
                                {
                                    <li class="list-group-item px-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@workout.WorkoutName</strong>
                                                <small class="d-block text-muted">@workout.TotalReservations reserveringen</small>
                                            </div>
                                            <span class="badge bg-primary rounded-pill">@($"{workout.AverageOccupancy:F0}%")</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center my-4">Geen data beschikbaar.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="row g-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recente Activiteit</h5>
                    </div>
                    <div class="card-body">
                        @if (_stats.RecentActivities.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var activity in _stats.RecentActivities)
                                {
                                    <li class="list-group-item px-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                @activity.Description
                                            </div>
                                            <small class="text-muted">@GetRelativeTime(activity.Timestamp)</small>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center my-4">Geen recente activiteit.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Kon dashboard gegevens niet laden. Probeer de pagina te verversen.
        </div>
    }
</div>

@code {
    private DashboardStatsDto? _stats;
    private bool _isLoading = true;
    private string _displayName = "Gebruiker";

    /// <summary>
    /// Initializes the dashboard by fetching user info and statistics from the database
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get authenticated user's display name
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            if (user.Identity?.IsAuthenticated == true)
            {
                _displayName = user.Identity.Name ?? "Gebruiker";
            }

            // Load dashboard statistics
            _stats = await DashboardService.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Returns appropriate Bootstrap badge class based on occupancy percentage
    /// </summary>
    private string GetOccupancyBadgeClass(double occupancy)
    {
        return occupancy switch
        {
            >= 90 => "bg-danger",
            >= 70 => "bg-warning",
            >= 50 => "bg-info",
            _ => "bg-success"
        };
    }

    /// <summary>
    /// Converts a timestamp to relative time format (e.g., "2 uur geleden")
    /// </summary>
    private string GetRelativeTime(DateTime timestamp)
    {
        var timeSpan = DateTime.Now - timestamp;

        if (timeSpan.TotalMinutes < 1)
            return "Zojuist";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} min geleden";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} uur geleden";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays} dagen geleden";
        
        return timestamp.ToString("dd MMM yyyy");
    }
}
