@page "/admin/instructors"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "employee,instructor")]
@inject IInstructorService InstructorService
@inject IPhotoUploadService PhotoUploadService
@inject IJSRuntime JS
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Instructeurs Beheer - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">Instructeurs Beheer</h1>
            <p class="text-muted">Beheer alle instructeurs</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-2"></i>Nieuwe Instructeur
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">laden...
            </p>
        </div>
    }
    else if (_instructors.Any())
    {
        <div class="row g-4">
            @foreach (var instructor in _instructors)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex align-items-start mb-3">
                                <div class="flex-shrink-0">
                                    <UserAvatar PhotoUrl="@instructor.PhotoUrl" DisplayName="@instructor.FullName" Size="60" />
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h5 class="card-title mb-1">@instructor.FullName</h5>
                                    @if (!string.IsNullOrEmpty(instructor.Email))
                                    {
                                        <p class="text-muted small mb-0"><i class="bi bi-envelope me-1"></i>@instructor.Email</p>
                                    }
                                </div>
                            </div>

                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <h4 class="mb-0 text-primary">@instructor.TotalLessons</h4>
                                        <small class="text-muted">Totaal Lessen</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2">
                                        <h4 class="mb-0 text-success">@instructor.UpcomingLessons</h4>
                                        <small class="text-muted">Komende Lessen</small>
                                    </div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditModal(instructor)">
                                    <i class="bi bi-pencil me-1"></i>Bewerken
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteInstructor(instructor.Id)">
                                    <i class="bi bi-trash me-1"></i>Verwijderen
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Geen instructeurs gevonden. Voeg een nieuwe instructeur toe.
        </div>
    }
</div>

@* ── Instructeur Create/Edit Modal ──────────────────────────────────────── *@
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingInstructor.Id == 0 ? "Nieuwe Instructeur" : "Instructeur Bewerken")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@_editingInstructor" OnValidSubmit="SaveInstructor">
                        <DataAnnotationsValidator />

                        @* ── Foto sectie ─────────────────────────── *@
                        <div class="mb-4 text-center">
                            @* Preview *@
                            @if (!string.IsNullOrEmpty(_previewUrl))
                            {
                                <img src="@_previewUrl"
                                     alt="preview"
                                     class="rounded-circle d-block mx-auto mb-2"
                                     style="width:96px;height:96px;object-fit:cover;
                                            border:3px solid var(--fitlife-primary);" />
                            }
                            else
                            {
                                <div class="d-flex justify-content-center mb-2">
                                    <UserAvatar PhotoUrl="@_editingInstructor.PhotoUrl"
                                                DisplayName="@_editingInstructor.FullName"
                                                Size="96" />
                                </div>
                            }

                            @* Buttons *@
                            <div class="d-flex gap-2 justify-content-center mt-1">
                                @* Bestand kiezen *@
                                <label class="btn btn-outline-primary btn-sm" style="cursor:pointer;"
                                       title="Kies een foto van schijf">
                                    @if (_isUploading)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-folder2-open me-1"></i>
                                        <span>Bestand</span>
                                    }
                                    <InputFile OnChange="OnFileSelected"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               style="display:none;"
                                               disabled="@_isUploading" />
                                </label>

                                @* Camera *@
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        title="Foto nemen met camera"
                                        @onclick="OpenCamera"
                                        disabled="@_isUploading">
                                    <i class="bi bi-camera me-1"></i>Camera
                                </button>
                            </div>

                            <div class="text-muted small mt-1">JPG · PNG · WebP · max 5 MB</div>

                            @if (!string.IsNullOrEmpty(_photoError))
                            {
                                <div class="alert alert-danger py-1 px-2 mt-2 small mb-0">@_photoError</div>
                            }
                            @if (_photoSaved)
                            {
                                <div class="text-success small mt-1">
                                    <i class="bi bi-check-circle-fill me-1"></i>Foto opgeslagen
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Voornaam *</label>
                            <InputText @bind-Value="_editingInstructor.FirstName" class="form-control" placeholder="John" />
                            <ValidationMessage For="@(() => _editingInstructor.FirstName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Achternaam</label>
                            <InputText @bind-Value="_editingInstructor.LastName" class="form-control" placeholder="Doe" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="_editingInstructor.Email" type="email" class="form-control" placeholder="john@fitlife.nl" />
                        </div>

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuleren</button>
                            <button type="submit" class="btn btn-primary" disabled="@(_isSaving || _isUploading)">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Opslaan
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@* ── Camera Modal ────────────────────────────────────────────────────────── *@
@if (_showCamera)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.7); z-index:1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-camera me-2"></i>Foto nemen</h5>
                    <button type="button" class="btn-close" @onclick="CloseCamera"></button>
                </div>
                <div class="modal-body text-center p-2">
                    @if (_cameraError)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Camera niet beschikbaar of geen toestemming.<br />
                            <small>Gebruik de "Bestand" knop om een foto te kiezen.</small>
                        </div>
                    }
                    else
                    {
                        <video id="fitlife-camera-video"
                               autoplay muted playsinline
                               style="width:100%;max-width:480px;border-radius:8px;background:#000;"></video>
                        <canvas id="fitlife-camera-canvas" style="display:none;"></canvas>
                    }
                </div>
                @if (!_cameraError)
                {
                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-primary px-4" @onclick="CapturePhoto">
                            <i class="bi bi-camera-fill me-2"></i>Foto nemen
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseCamera">Annuleren</button>
                    </div>
                }
                else
                {
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCamera">Sluiten</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // ── State ─────────────────────────────────────────────────────────────
    private List<InstructorDto> _instructors    = new();
    private InstructorDto       _editingInstructor = new();
    private bool _isLoading  = true;
    private bool _isSaving   = false;
    private bool _showModal  = false;

    // Photo state — store bytes, never the IBrowserFile reference
    private byte[]? _pendingBytes;
    private string   _pendingMime  = "image/jpeg";
    private string   _pendingName  = "photo.jpg";
    private string?  _previewUrl;
    private string   _photoError   = string.Empty;
    private bool     _isUploading  = false;
    private bool     _photoSaved   = false;

    // Camera state
    private bool _showCamera  = false;
    private bool _cameraError = false;

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _isLoading = true;
        try   { _instructors = await InstructorService.GetAllInstructorsAsync(); }
        catch { ToastService.ShowError("Fout bij laden van instructeurs."); }
        finally { _isLoading = false; }
    }

    // ── Modal open/close ───────────────────────────────────────────────────
    private void OpenCreateModal()
    {
        _editingInstructor = new();
        ResetPhotoState();
        _showModal = true;
    }

    private void OpenEditModal(InstructorDto i)
    {
        _editingInstructor = new InstructorDto
        {
            Id             = i.Id,
            FirstName      = i.FirstName,
            LastName       = i.LastName,
            Email          = i.Email,
            Specialization = i.Specialization,
            PhotoUrl       = i.PhotoUrl
        };
        ResetPhotoState();
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingInstructor = new();
        ResetPhotoState();
    }

    private void ResetPhotoState()
    {
        _pendingBytes = null;
        _previewUrl   = null;
        _photoError   = string.Empty;
        _isUploading  = false;
        _photoSaved   = false;
    }

    // ── File picker ────────────────────────────────────────────────────────
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _photoError = string.Empty;
        _photoSaved = false;
        StateHasChanged();

        var file = e.File;
        var ext  = Path.GetExtension(file.Name).ToLowerInvariant();

        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp"))
        {
            _photoError = "Alleen JPG, PNG of WebP.";
            StateHasChanged();
            return;
        }
        if (file.Size > 5 * 1024 * 1024)
        {
            _photoError = "Bestand mag maximaal 5 MB zijn.";
            StateHasChanged();
            return;
        }

        _isUploading = true;
        StateHasChanged();

        try
        {
            // Read ALL bytes now — IBrowserFile is only valid during this event
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            _pendingBytes = ms.ToArray();
            _pendingMime  = ext is ".png" ? "image/png" : ext is ".webp" ? "image/webp" : "image/jpeg";
            _pendingName  = file.Name;

            _previewUrl = $"data:{_pendingMime};base64,{Convert.ToBase64String(_pendingBytes)}";
            StateHasChanged(); // show preview immediately

            await UploadPendingPhotoAsync();
        }
        catch (Exception ex)
        {
            _photoError = "Kon bestand niet lezen: " + ex.Message;
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    // ── Camera ─────────────────────────────────────────────────────────────
    private async Task OpenCamera()
    {
        _showCamera  = true;
        _cameraError = false;
        StateHasChanged();

        // Give the DOM a tick to render the video element
        await Task.Delay(100);

        var ok = await JS.InvokeAsync<bool>("fitlifeCamera.start", "fitlife-camera-video");
        if (!ok)
        {
            _cameraError = true;
            StateHasChanged();
        }
    }

    private async Task CloseCamera()
    {
        await JS.InvokeVoidAsync("fitlifeCamera.stop");
        _showCamera  = false;
        _cameraError = false;
        StateHasChanged();
    }

    private async Task CapturePhoto()
    {
        var dataUrl = await JS.InvokeAsync<string?>(
            "fitlifeCamera.capture", "fitlife-camera-video", "fitlife-camera-canvas");

        if (string.IsNullOrEmpty(dataUrl))
        {
            _photoError = "Foto nemen mislukt.";
            await CloseCamera();
            StateHasChanged();
            return;
        }

        await CloseCamera();

        // Convert data URL → bytes
        var comma = dataUrl.IndexOf(',');
        if (comma < 0) { _photoError = "Ongeldige cameraopname."; StateHasChanged(); return; }

        _isUploading = true;
        _photoError  = string.Empty;
        _photoSaved  = false;

        _pendingBytes = Convert.FromBase64String(dataUrl[(comma + 1)..]);
        _pendingMime  = "image/jpeg";
        _pendingName  = $"camera_{DateTime.Now:yyyyMMdd_HHmmss}.jpg";
        _previewUrl   = dataUrl;

        StateHasChanged();

        try   { await UploadPendingPhotoAsync(); }
        catch (Exception ex) { _photoError = "Upload mislukt: " + ex.Message; }
        finally { _isUploading = false; StateHasChanged(); }
    }

    // ── Shared upload logic ────────────────────────────────────────────────
    // Only uploads immediately when the instructor already has an ID.
    // For new instructors, bytes stay in _pendingBytes until SaveInstructor runs.
    private async Task UploadPendingPhotoAsync()
    {
        if (_pendingBytes is null) return;
        if (_editingInstructor.Id <= 0) return; // wait until saved

        var wrapper = new BytesBrowserFile(_pendingName, _pendingMime, _pendingBytes);
        var (ok, url, err) = await PhotoUploadService.UploadAsync(_editingInstructor.Id, wrapper);

        if (ok && url != null)
        {
            _editingInstructor.PhotoUrl = url;
            _pendingBytes = null; // consumed
            _photoSaved   = true;
        }
        else
        {
            _photoError = string.IsNullOrEmpty(err) ? "Upload mislukt." : err;
        }
    }

    // ── Save instructor ────────────────────────────────────────────────────
    private async Task SaveInstructor()
    {
        _isSaving = true;
        try
        {
            var isNew = _editingInstructor.Id == 0;
            var (ok, msg) = isNew
                ? await InstructorService.CreateInstructorAsync(_editingInstructor)
                : await InstructorService.UpdateInstructorAsync(_editingInstructor);

            if (!ok) { ToastService.ShowError(msg); return; }

            // New instructor: upload pending photo now that we have an ID
            if (isNew && _pendingBytes is not null)
            {
                await LoadData(); // refresh to get the new ID
                var saved = _instructors.FirstOrDefault(i =>
                    i.FirstName == _editingInstructor.FirstName &&
                    i.LastName  == _editingInstructor.LastName);

                if (saved?.Id > 0)
                {
                    _editingInstructor.Id = saved.Id;
                    await UploadPendingPhotoAsync();
                }
            }

            ToastService.ShowSuccess(msg);
            CloseModal();
            await LoadData();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Fout bij opslaan: " + ex.Message);
        }
        finally { _isSaving = false; }
    }

    // ── Delete ─────────────────────────────────────────────────────────────
    private async Task DeleteInstructor(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Weet je zeker dat je deze instructeur wilt verwijderen?"))
            return;

        var (ok, msg) = await InstructorService.DeleteInstructorAsync(id);
        if (ok) { ToastService.ShowSuccess(msg); await LoadData(); }
        else    ToastService.ShowError(msg);
    }

    // ── Helper: wrap bytes as IBrowserFile ─────────────────────────────────
    private sealed class BytesBrowserFile : IBrowserFile
    {
        private readonly byte[] _data;
        public BytesBrowserFile(string name, string contentType, byte[] data)
        {
            Name        = name;
            ContentType = contentType;
            Size        = data.Length;
            _data       = data;
            LastModified = DateTimeOffset.UtcNow;
        }
        public string         Name         { get; }
        public DateTimeOffset LastModified  { get; }
        public long           Size         { get; }
        public string         ContentType  { get; }
        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken ct = default)
            => new MemoryStream(_data);
    }
}