@page "/admin/members"
@attribute [Authorize(Roles = "employee,instructor")]
@inject IUserService UserService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Leden Beheer - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">Leden Beheer</h1>
            <p class="text-muted">Overzicht van alle gebruikers</p>
        </div>
        <div class="col-auto">
            <div class="btn-group" role="group">
                <button type="button" class="btn @(_roleFilter == null ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByRole(null)'>
                    Alle (@_allUsers.Count)
                </button>
                <button type="button" class="btn @(_roleFilter == "member" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByRole("member")'>
                    Leden (@_allUsers.Count(u => u.Role == "member"))
                </button>
                <button type="button" class="btn @(_roleFilter == "instructor" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByRole("instructor")'>
                    Instructeurs (@_allUsers.Count(u => u.Role == "instructor"))
                </button>
                <button type="button" class="btn @(_roleFilter == "admin" ? "btn-primary" : "btn-outline-primary")" @onclick='() => FilterByRole("admin")'>
                    Admins (@_allUsers.Count(u => u.Role == "admin"))
                </button>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Leden laden...</p>
        </div>
    }
    else if (_displayedUsers.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Gebruiker</th>
                                <th>Email</th>
                                <th>Rol</th>
                                <th>Reserveringen</th>
                                <th>Laatste Activiteit</th>
                                <th>Lid Sinds</th>
                                <th class="text-end">Acties</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _displayedUsers)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(user.PhotoUrl))
                                            {
                                                <img src="@user.PhotoUrl" alt="@user.DisplayName" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 14px;">
                                                    @user.DisplayName.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                            <strong>@user.DisplayName</strong>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge @GetRoleBadgeClass(user.Role)">
                                            @GetRoleDisplayName(user.Role)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@user.TotalReservations</span>
                                    </td>
                                    <td>
                                        @if (user.LastActivity.HasValue)
                                        {
                                            <small class="text-muted">@user.LastActivity.Value.ToString("dd MMM yyyy")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Nooit</small>
                                        }
                                    </td>
                                    <td>
                                        @if (user.CreatedAt.HasValue)
                                        {
                                            <small class="text-muted">@user.CreatedAt.Value.ToString("dd MMM yyyy")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">-</small>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><h6 class="dropdown-header">Wijzig Rol</h6></li>
                                                <li><button class="dropdown-item" @onclick='() => UpdateUserRole(user.Id, "member")'>
                                                    <i class="bi bi-person me-2"></i>Lid
                                                </button></li>
                                                <li><button class="dropdown-item" @onclick='() => UpdateUserRole(user.Id, "instructor")'>
                                                    <i class="bi bi-person-badge me-2"></i>Instructeur
                                                </button></li>
                                                <li><button class="dropdown-item" @onclick='() => UpdateUserRole(user.Id, "admin")'>
                                                    <i class="bi bi-shield-check me-2"></i>Admin
                                                </button></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3 text-muted">
            <small>Toont @_displayedUsers.Count van @_allUsers.Count gebruikers</small>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Geen gebruikers gevonden met de geselecteerde filter.
        </div>
    }
</div>

@code {
    private List<MemberDto> _allUsers = new();
    private List<MemberDto> _displayedUsers = new();
    private bool _isLoading = true;
    private string? _roleFilter = null;

    /// <summary>
    /// Loads all users when component initializes
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// Loads all users from the database
    /// </summary>
    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _allUsers = await UserService.GetAllUsersAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading users: {ex.Message}");
            ToastService.ShowError("Fout bij laden van gebruikers.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Filters users by role
    /// </summary>
    private void FilterByRole(string? role)
    {
        _roleFilter = role;
        ApplyFilter();
    }

    /// <summary>
    /// Applies the current filter to the user list
    /// </summary>
    private void ApplyFilter()
    {
        _displayedUsers = string.IsNullOrEmpty(_roleFilter)
            ? _allUsers
            : _allUsers.Where(u => u.Role == _roleFilter).ToList();
    }

    /// <summary>
    /// Updates a user's role
    /// </summary>
    private async Task UpdateUserRole(int userId, string newRole)
    {
        try
        {
            var (success, message) = await UserService.UpdateUserRoleAsync(userId, newRole);
            
            if (success)
            {
                ToastService.ShowSuccess(message);
                await LoadData();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating user role: {ex.Message}");
            ToastService.ShowError("Fout bij bijwerken van gebruikersrol.");
        }
    }

    /// <summary>
    /// Returns Bootstrap badge class based on role
    /// </summary>
    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "admin" => "bg-danger",
            "instructor" => "bg-success",
            "member" => "bg-primary",
            _ => "bg-secondary"
        };
    }

    /// <summary>
    /// Returns Dutch display name for role
    /// </summary>
    private string GetRoleDisplayName(string role)
    {
        return role switch
        {
            "admin" => "Admin",
            "instructor" => "Instructeur",
            "member" => "Lid",
            _ => role
        };
    }
}
