@page "/admin/locations"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "employee,instructor")]
@inject ILocationService LocationService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Locaties Beheer - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">Locaties Beheer</h1>
            <p class="text-muted">Bekijk en pas de capaciteit van locaties aan</p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Locaties laden...</p>
        </div>
    }
    else if (_locations.Any())
    {
        <div class="row g-4">
            @foreach (var location in _locations)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-2">
                                <i class="bi bi-geo-alt-fill text-danger me-2"></i>@location.Name
                            </h5>

                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <i class="bi bi-people-fill text-primary fs-4"></i>
                                        <h5 class="mb-0 mt-1">@location.Capacity</h5>
                                        <small class="text-muted">Max Capaciteit</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-light">
                                        <i class="bi bi-calendar-event text-success fs-4"></i>
                                        <h5 class="mb-0 mt-1">@location.TotalLessons</h5>
                                        <small class="text-muted">Geplande Lessen</small>
                                    </div>
                                </div>
                            </div>

                            <button class="btn btn-outline-primary btn-sm w-100" @onclick="() => OpenEditModal(location)">
                                <i class="bi bi-pencil me-1"></i>Capaciteit aanpassen
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Geen locaties gevonden.
        </div>
    }
</div>

@if (_showModal && _editingLocation != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="bi bi-people-fill text-primary me-2"></i>@_editingLocation.Name
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body pt-0">
                    <label class="form-label fw-semibold">Maximale capaciteit</label>
                    <input type="number" class="form-control form-control-lg text-center"
                           min="1" max="9999"
                           @bind="_editingLocation.Capacity" />
                    <small class="text-muted">Aantal personen dat tegelijk in deze ruimte past</small>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="CloseModal" disabled="@_isSaving">Annuleren</button>
                    <button class="btn btn-primary" @onclick="SaveCapacity" disabled="@_isSaving">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Opslaan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LocationDto> _locations = new();
    private LocationDto? _editingLocation = null;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _locations = await LocationService.GetAllLocationsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading locations: {ex.Message}");
            ToastService.ShowError("Fout bij laden van locaties.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEditModal(LocationDto location)
    {
        _editingLocation = new LocationDto
        {
            Id       = location.Id,
            Name     = location.Name,
            Address  = location.Address,
            Capacity = location.Capacity
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingLocation = null;
    }

    private async Task SaveCapacity()
    {
        if (_editingLocation == null) return;
        if (_editingLocation.Capacity < 1)
        {
            ToastService.ShowError("Capaciteit moet minimaal 1 zijn.");
            return;
        }

        _isSaving = true;
        var (success, message) = await LocationService.UpdateLocationAsync(_editingLocation);
        _isSaving = false;

        if (success)
        {
            ToastService.ShowSuccess($"Capaciteit van {_editingLocation.Name} bijgewerkt naar {_editingLocation.Capacity}.");
            CloseModal();
            await LoadData();
        }
        else
        {
            ToastService.ShowError(message);
        }
    }
}
