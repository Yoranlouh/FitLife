@page "/admin/workouts"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "employee,instructor")]
@inject IWorkoutService WorkoutService
@inject Blazored.Toast.Services.IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Workouts Beheer - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">Workouts Beheer</h1>
            <p class="text-muted">Beheer alle workout types</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-2"></i>Nieuwe Workout
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Workouts laden...</p>
        </div>
    }
    else if (_workouts.Any())
    {
        <div class="row g-4">
            @foreach (var workout in _workouts)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title fw-bold">@workout.Name</h5>
                                    <span class="badge bg-info">Max @workout.DefaultCapacity pers.</span>
                                </div>
                                <i class="bi bi-lightning-charge-fill fs-1 text-warning opacity-50"></i>
                            </div>

                            @if (!string.IsNullOrEmpty(workout.Description))
                            {
                                <p class="card-text text-muted small mb-3">@workout.Description</p>
                            }

                            <div class="alert alert-light mb-3">
                                <i class="bi bi-calendar-check me-2"></i>
                                <strong>@workout.TotalLessons</strong> geplande lessen
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditModal(workout)">
                                    <i class="bi bi-pencil me-1"></i>Bewerken
                                </button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteWorkout(workout.Id)">
                                    <i class="bi bi-trash me-1"></i>Verwijderen
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Geen workouts gevonden. Voeg een nieuwe workout toe.
        </div>
    }
</div>

@* Modal for Create/Edit Workout *@
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingWorkout.Id == 0 ? "Nieuwe Workout Aanmaken" : "Workout Bewerken")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@_editingWorkout" OnValidSubmit="SaveWorkout">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Naam *</label>
                            <InputText @bind-Value="_editingWorkout.Name" class="form-control" placeholder="Yoga, Spinning, CrossFit..." />
                            <ValidationMessage For="@(() => _editingWorkout.Name)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Beschrijving</label>
                            <InputTextArea @bind-Value="_editingWorkout.Description" class="form-control" rows="3" placeholder="Korte beschrijving van de workout..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Standaard Capaciteit *</label>
                            <InputNumber @bind-Value="_editingWorkout.DefaultCapacity" class="form-control" />
                            <ValidationMessage For="@(() => _editingWorkout.DefaultCapacity)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuleren</button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                @(_isSaving ? "Opslaan..." : "Opslaan")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<WorkoutDto> _workouts = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _showModal = false;
    private WorkoutDto _editingWorkout = new();

    /// <summary>
    /// Loads all workouts when component initializes
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// Loads workouts from the database
    /// </summary>
    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            _workouts = await WorkoutService.GetAllWorkoutsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading workouts: {ex.Message}");
            ToastService.ShowError("Fout bij laden van workouts.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Opens modal for creating a new workout
    /// </summary>
    private void OpenCreateModal()
    {
        _editingWorkout = new WorkoutDto { DefaultCapacity = 15 };
        _showModal = true;
    }

    /// <summary>
    /// Opens modal for editing an existing workout
    /// </summary>
    private void OpenEditModal(WorkoutDto workout)
    {
        _editingWorkout = new WorkoutDto
        {
            Id = workout.Id,
            Name = workout.Name,
            Description = workout.Description,
            DefaultCapacity = workout.DefaultCapacity
        };
        _showModal = true;
    }

    /// <summary>
    /// Closes the modal and resets state
    /// </summary>
    private void CloseModal()
    {
        _showModal = false;
        _editingWorkout = new();
    }

    /// <summary>
    /// Saves workout (create or update) to database
    /// </summary>
    private async Task SaveWorkout()
    {
        _isSaving = true;
        try
        {
            var (success, message) = _editingWorkout.Id == 0
                ? await WorkoutService.CreateWorkoutAsync(_editingWorkout)
                : await WorkoutService.UpdateWorkoutAsync(_editingWorkout);

            if (success)
            {
                ToastService.ShowSuccess(message);
                CloseModal();
                await LoadData();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving workout: {ex.Message}");
            ToastService.ShowError("Fout bij opslaan van workout.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Deletes a workout after validation
    /// </summary>
    private async Task DeleteWorkout(int workoutId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Weet je zeker dat je deze workout wilt verwijderen?"))
            return;

        var (success, message) = await WorkoutService.DeleteWorkoutAsync(workoutId);
        
        if (success)
        {
            ToastService.ShowSuccess(message);
            await LoadData();
        }
        else
        {
            ToastService.ShowError(message);
        }
    }
}
