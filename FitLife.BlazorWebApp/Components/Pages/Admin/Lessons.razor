@page "/admin/lessons"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "employee,instructor")]
@inject ILessonService LessonService
@inject IWorkoutService WorkoutService
@inject IInstructorService InstructorService
@inject ILocationService LocationService
@inject IToastService ToastService

<PageTitle>Lessen Beheer - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">Lessen Beheer</h1>
            <p class="text-muted">
                @if (_showArchive)
                {
                    <span><i class="bi bi-archive me-1"></i>Archief — verlopen lessen</span>
                }
                else
                {
                    <span>Aankomende en huidige lessen</span>
                }
            </p>
        </div>
        <div class="col-auto d-flex gap-2">
            <button class="btn @(_showArchive ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="ToggleArchive">
                <i class="bi bi-archive me-1"></i>@(_showArchive ? "Toon aankomend" : "Archief")
            </button>
            @if (!_showArchive)
            {
                <button class="btn btn-primary" @onclick="OpenCreateModal">
                    <i class="bi bi-plus-circle me-2"></i>Nieuwe Les
                </button>
            }
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Lessen laden...</p>
        </div>
    }
    else if (_lessons.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Datum & Tijd</th>
                                <th>Workout</th>
                                <th>Instructeur</th>
                                <th>Locatie</th>
                                <th>Bezetting</th>
                                <th class="text-end">Acties</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lesson in _lessons)
                            {
                                <tr>
                                    <td>
                                        <strong>@lesson.StartTime.ToString("dd MMM yyyy")</strong><br />
                                        <small class="text-muted">@lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")</small>
                                    </td>
                                    <td>@lesson.WorkoutName</td>
                                    <td>@lesson.InstructorName</td>
                                    <td>@lesson.LocationName</td>
                                    <td>
                                        <span class="badge @GetOccupancyBadgeClass(lesson.OccupancyPercentage)">
                                            @lesson.CurrentParticipants/@lesson.MaxParticipants
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(lesson)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(lesson.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            @if (_showArchive)
            {
                <span>Geen gearchiveerde lessen gevonden.</span>
            }
            else
            {
                <span>Geen aankomende lessen gevonden. Maak een nieuwe les aan.</span>
            }
        </div>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingLesson.Id == 0 ? "Nieuwe Les Aanmaken" : "Les Bewerken")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@_editingLesson" OnValidSubmit="SaveLesson">
                        <DataAnnotationsValidator />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Workout Type *</label>
                                <InputSelect @bind-Value="_editingLesson.WorkoutId" class="form-select">
                                    <option value="0">-- Selecteer Workout --</option>
                                    @foreach (var workout in _workouts)
                                    {
                                        <option value="@workout.Id">@workout.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _editingLesson.WorkoutId)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Instructeur *</label>
                                <InputSelect @bind-Value="_editingLesson.InstructorId" class="form-select">
                                    <option value="0">-- Selecteer Instructeur --</option>
                                    @foreach (var instructor in _instructors)
                                    {
                                        <option value="@instructor.Id">@instructor.FullName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _editingLesson.InstructorId)" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Locatie *</label>
                                <InputSelect @bind-Value="_editingLesson.LocationId" class="form-select">
                                    <option value="0">-- Selecteer Locatie --</option>
                                    @foreach (var location in _locations)
                                    {
                                        <option value="@location.Id">@location.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _editingLesson.LocationId)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Duur (minuten)</label>
                                <InputNumber @bind-Value="_editingLesson.DurationMinutes" class="form-control" />
                                <ValidationMessage For="@(() => _editingLesson.DurationMinutes)" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Start Datum & Tijd *</label>
                                <InputDate @bind-Value="_editingLesson.StartTime" Type="InputDateType.DateTimeLocal" class="form-control" />
                                <ValidationMessage For="@(() => _editingLesson.StartTime)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Max Deelnemers <small class="text-muted">(optioneel)</small></label>
                                <InputNumber @bind-Value="_editingLesson.CapacityOverride" class="form-control" placeholder="Standaard locatie/workout" />
                                <ValidationMessage For="@(() => _editingLesson.CapacityOverride)" />
                            </div>
                        </div>

                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuleren</button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Opslaan
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Les verwijderen</h5>
                    <button type="button" class="btn-close" @onclick="() => _showDeleteConfirm = false"></button>
                </div>
                <div class="modal-body">
                    Weet je zeker dat je deze les wilt verwijderen?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => _showDeleteConfirm = false">Annuleren</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteLesson" disabled="@_isSaving">Verwijderen</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LessonDto> _lessons = new();
    private List<WorkoutDto> _workouts = new();
    private List<InstructorDto> _instructors = new();
    private List<LocationDto> _locations = new();

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _showModal = false;
    private bool _showDeleteConfirm = false;
    private bool _showArchive = false;
    private int _deleteTargetId = 0;

    private LessonEditDto _editingLesson = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task ToggleArchive()
    {
        _showArchive = !_showArchive;
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var lessonsTask = LessonService.GetAllLessonsAsync(archivedOnly: _showArchive);
            var workoutsTask = WorkoutService.GetAllWorkoutsAsync();
            var instructorsTask = InstructorService.GetAllInstructorsAsync();
            var locationsTask = LocationService.GetAllLocationsAsync();

            await Task.WhenAll(lessonsTask, workoutsTask, instructorsTask, locationsTask);

            _lessons = lessonsTask.Result;
            _workouts = workoutsTask.Result;
            _instructors = instructorsTask.Result;
            _locations = locationsTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            ToastService.ShowError("Fout bij laden van gegevens.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _editingLesson = new LessonEditDto
        {
            StartTime = DateTime.Today.AddDays(1).AddHours(9),
            DurationMinutes = 60
        };
        _showModal = true;
    }

    private void OpenEditModal(LessonDto lesson)
    {
        _editingLesson = new LessonEditDto
        {
            Id = lesson.Id,
            StartTime = lesson.StartTime,
            DurationMinutes = (int)(lesson.EndTime - lesson.StartTime).TotalMinutes,
            CapacityOverride = lesson.CapacityOverride, // raw override: null = inherits location/workout capacity
            WorkoutId = lesson.WorkoutId,
            InstructorId = lesson.InstructorId,
            LocationId = lesson.LocationId
        };
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editingLesson = new();
    }

    private async Task SaveLesson()
    {
        _isSaving = true;
        try
        {
            var (success, message) = _editingLesson.Id == 0
                ? await LessonService.CreateLessonAsync(_editingLesson)
                : await LessonService.UpdateLessonAsync(_editingLesson);

            if (success)
            {
                ToastService.ShowSuccess(message);
                CloseModal();
                await LoadData();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving lesson: {ex.Message}");
            ToastService.ShowError("Fout bij opslaan van les.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(int lessonId)
    {
        _deleteTargetId = lessonId;
        _showDeleteConfirm = true;
    }

    private async Task DeleteLesson()
    {
        _isSaving = true;
        var (success, message) = await LessonService.DeleteLessonAsync(_deleteTargetId);
        _showDeleteConfirm = false;
        _isSaving = false;

        if (success)
        {
            ToastService.ShowSuccess(message);
            await LoadData();
        }
        else
        {
            ToastService.ShowError(message);
        }
    }

    private string GetOccupancyBadgeClass(double occupancy) => occupancy switch
    {
        >= 90 => "bg-danger",
        >= 70 => "bg-warning text-dark",
        >= 50 => "bg-info",
        _ => "bg-success"
    };
}