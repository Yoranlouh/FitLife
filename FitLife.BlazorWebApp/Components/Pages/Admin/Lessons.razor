@page "/admin/lessons"
@using FitLife.BlazorWebApp.Services
@using FitLife.BlazorWebApp.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin,instructor")]
@inject ILessonService LessonService
@inject IWorkoutService WorkoutService
@inject IInstructorService InstructorService
@inject ILocationService LocationService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Lessen Beheer - FitLife Admin</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold">Lessen Beheer</h1>
            <p class="text-muted">Beheer alle geplande lessen</p>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                <i class="bi bi-plus-circle me-2"></i>Nieuwe Les
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Lessen laden...</p>
        </div>
    }
    else if (_lessons.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Datum & Tijd</th>
                                <th>Workout</th>
                                <th>Instructeur</th>
                                <th>Locatie</th>
                                <th>Bezetting</th>
                                <th class="text-end">Acties</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lesson in _lessons)
                            {
                                <tr>
                                    <td>
                                        <strong>@lesson.StartTime.ToString("dd MMM yyyy")</strong><br />
                                        <small class="text-muted">@lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")</small>
                                    </td>
                                    <td>@lesson.WorkoutName</td>
                                    <td>@lesson.InstructorName</td>
                                    <td>@lesson.LocationName</td>
                                    <td>
                                        <span class="badge @GetOccupancyBadgeClass(lesson.OccupancyPercentage)">
                                            @lesson.CurrentParticipants/@lesson.MaxParticipants
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(lesson)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLesson(lesson.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Geen lessen gevonden. Maak een nieuwe les aan.
        </div>
    }
</div>

@* Modal for Create/Edit Lesson *@
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editingLesson.Id == 0 ? "Nieuwe Les Aanmaken" : "Les Bewerken")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@_editingLesson" OnValidSubmit="SaveLesson">
                        <DataAnnotationsValidator />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Workout Type</label>
                                <InputSelect @bind-Value="_editingLesson.WorkoutId" class="form-select">
                                    <option value="0">-- Selecteer Workout --</option>
                                    @foreach (var workout in _workouts)
                                    {
                                        <option value="@workout.Id">@workout.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Instructeur</label>
                                <InputSelect @bind-Value="_editingLesson.InstructorId" class="form-select">
                                    <option value="0">-- Selecteer Instructeur --</option>
                                    @foreach (var instructor in _instructors)
                                    {
                                        <option value="@instructor.Id">@instructor.FullName</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Locatie</label>
                                <InputSelect @bind-Value="_editingLesson.LocationId" class="form-select">
                                    <option value="0">-- Selecteer Locatie --</option>
                                    @foreach (var location in _locations)
                                    {
                                        <option value="@location.Id">@location.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Duur (minuten)</label>
                                <InputNumber @bind-Value="_editingLesson.DurationMinutes" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label">Start Datum & Tijd</label>
                                <InputDate @bind-Value="_editingLesson.StartTime" Type="InputDateType.DateTimeLocal" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Max Deelnemers (optioneel)</label>
                                <InputNumber @bind-Value="_editingLesson.CapacityOverride" class="form-control" />
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuleren</button>
                            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                @(_isSaving ? "Opslaan..." : "Opslaan")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LessonDto> _lessons = new();
    private List<WorkoutDto> _workouts = new();
    private List<InstructorDto> _instructors = new();
    private List<LocationDto> _locations = new();
    
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _showModal = false;
    
    private LessonEditDto _editingLesson = new();

    /// <summary>
    /// Loads all lessons and supporting data (workouts, instructors, locations) when component initializes
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// Loads lessons and all supporting reference data from the database
    /// </summary>
    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var fromDate = DateTime.Today.AddMonths(-1);
            var toDate = DateTime.Today.AddMonths(2);
            
            _lessons = await LessonService.GetAllLessonsAsync(fromDate, toDate);
            _workouts = await WorkoutService.GetAllWorkoutsAsync();
            _instructors = await InstructorService.GetAllInstructorsAsync();
            _locations = await LocationService.GetAllLocationsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            ToastService.ShowError("Fout bij laden van gegevens.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Opens the modal dialog for creating a new lesson
    /// </summary>
    private void OpenCreateModal()
    {
        _editingLesson = new LessonEditDto { StartTime = DateTime.Today.AddDays(1).AddHours(9) };
        _showModal = true;
    }

    /// <summary>
    /// Opens the modal dialog for editing an existing lesson
    /// </summary>
    private void OpenEditModal(LessonDto lesson)
    {
        _editingLesson = new LessonEditDto
        {
            Id = lesson.Id,
            StartTime = lesson.StartTime,
            DurationMinutes = (int)(lesson.EndTime - lesson.StartTime).TotalMinutes,
            CapacityOverride = lesson.MaxParticipants,
            WorkoutId = lesson.WorkoutId,
            InstructorId = lesson.InstructorId,
            LocationId = lesson.LocationId
        };
        _showModal = true;
    }

    /// <summary>
    /// Closes the modal dialog and resets editing state
    /// </summary>
    private void CloseModal()
    {
        _showModal = false;
        _editingLesson = new();
    }

    /// <summary>
    /// Saves the lesson (creates new or updates existing) to the database
    /// </summary>
    private async Task SaveLesson()
    {
        _isSaving = true;
        try
        {
            var (success, message) = _editingLesson.Id == 0
                ? await LessonService.CreateLessonAsync(_editingLesson)
                : await LessonService.UpdateLessonAsync(_editingLesson);

            if (success)
            {
                ToastService.ShowSuccess(message);
                CloseModal();
                await LoadData();
            }
            else
            {
                ToastService.ShowError(message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving lesson: {ex.Message}");
            ToastService.ShowError("Fout bij opslaan van les.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Deletes a lesson after confirmation
    /// </summary>
    private async Task DeleteLesson(int lessonId)
    {
        // In production, add a confirmation dialog here
        var (success, message) = await LessonService.DeleteLessonAsync(lessonId);
        
        if (success)
        {
            ToastService.ShowSuccess(message);
            await LoadData();
        }
        else
        {
            ToastService.ShowError(message);
        }
    }

    /// <summary>
    /// Returns Bootstrap badge color class based on occupancy percentage
    /// </summary>
    private string GetOccupancyBadgeClass(double occupancy)
    {
        return occupancy switch
        {
            >= 90 => "bg-danger",
            >= 70 => "bg-warning text-dark",
            >= 50 => "bg-info",
            _ => "bg-success"
        };
    }
}
