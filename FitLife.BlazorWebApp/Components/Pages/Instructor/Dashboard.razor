@page "/instructor/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "instructor")]
@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Instructeur Dashboard - FitLife</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">Mijn Dashboard</h1>
            <p class="text-muted">Welkom terug, @_displayName</p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Dashboard laden...</p>
        </div>
    }
    else if (_data != null)
    {
        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-primary shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Lessen Gegeven</h6>
                                <h2 class="card-title fw-bold mb-0">@_data.TotalLessonsGiven</h2>
                            </div>
                            <i class="bi bi-calendar-check-fill fs-1 text-primary opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Komende Lessen</h6>
                                <h2 class="card-title fw-bold mb-0">@_data.TotalUpcomingLessons</h2>
                            </div>
                            <i class="bi bi-clock-fill fs-1 text-success opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Lessen Vandaag</h6>
                                <h2 class="card-title fw-bold mb-0">@_data.TodaysLessons.Count</h2>
                            </div>
                            <i class="bi bi-calendar-day-fill fs-1 text-info opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-subtitle mb-2 text-muted">Unieke Deelnemers</h6>
                                <h2 class="card-title fw-bold mb-0">@_data.TotalStudentsTaught</h2>
                            </div>
                            <i class="bi bi-people-fill fs-1 text-warning opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <!-- Today's Lessons -->
            @if (_data.TodaysLessons.Any())
            {
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Mijn Lessen Vandaag</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr><th>Tijd</th><th>Workout</th><th>Locatie</th><th>Bezetting</th><th>Status</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lesson in _data.TodaysLessons)
                                        {
                                            <tr>
                                                <td><strong>@lesson.StartTime.ToString("HH:mm")</strong> - @lesson.EndTime.ToString("HH:mm")</td>
                                                <td><strong>@lesson.WorkoutName</strong></td>
                                                <td>@lesson.LocationName</td>
                                                <td>
                                                    <div class="progress" style="height:20px;">
                                                        <div class="progress-bar @GetProgressBarClass(lesson.OccupancyPercentage)"
                                                             role="progressbar"
                                                             style="width:@lesson.OccupancyPercentage%">
                                                            @lesson.CurrentParticipants/@lesson.MaxParticipants
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (lesson.StartTime <= DateTime.Now && lesson.EndTime >= DateTime.Now)
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-play-circle me-1"></i>Bezig</span>
                                                    }
                                                    else if (lesson.StartTime > DateTime.Now)
                                                    {
                                                        <span class="badge bg-primary"><i class="bi bi-clock me-1"></i>Gepland</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary"><i class="bi bi-check-circle me-1"></i>Voltooid</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mb-4">
            <!-- Upcoming Lessons -->
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-calendar-range me-2"></i>Komende Lessen</h5>
                    </div>
                    <div class="card-body">
                        @if (_data.UpcomingLessons.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr><th>Datum & Tijd</th><th>Workout</th><th>Locatie</th><th>Bezetting</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lesson in _data.UpcomingLessons)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@lesson.StartTime.ToString("dd MMM yyyy")</strong>
                                                    <br /><small class="text-muted">@lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")</small>
                                                </td>
                                                <td>@lesson.WorkoutName</td>
                                                <td>@lesson.LocationName</td>
                                                <td>
                                                    <span class="badge @GetOccupancyBadgeClass(lesson.OccupancyPercentage)">
                                                        @lesson.CurrentParticipants/@lesson.MaxParticipants (@($"{lesson.OccupancyPercentage:F0}%"))
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center my-4">Geen komende lessen gepland.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Top Workouts -->
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-fire me-2"></i>Meest Gegeven Workouts</h5>
                    </div>
                    <div class="card-body">
                        @if (_data.TopWorkouts.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var stat in _data.TopWorkouts)
                                {
                                    <li class="list-group-item px-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@stat.WorkoutName</strong>
                                                <small class="d-block text-muted">@stat.TotalStudents deelnemers totaal</small>
                                            </div>
                                            <span class="badge bg-primary rounded-pill">@stat.LessonCount les@(stat.LessonCount == 1 ? "" : "sen")</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center my-4">Nog geen lessen gegeven.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Lesson History -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recente Les Historie</h5>
                    </div>
                    <div class="card-body">
                        @if (_data.RecentLessons.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr><th>Datum & Tijd</th><th>Workout</th><th>Locatie</th><th>Deelnemers</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lesson in _data.RecentLessons)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@lesson.StartTime.ToString("dd MMM yyyy")</strong>
                                                    <br /><small class="text-muted">@lesson.StartTime.ToString("HH:mm") - @lesson.EndTime.ToString("HH:mm")</small>
                                                </td>
                                                <td>@lesson.WorkoutName</td>
                                                <td>@lesson.LocationName</td>
                                                <td>
                                                    <span class="badge @GetOccupancyBadgeClass(lesson.OccupancyPercentage)">
                                                        @lesson.CurrentParticipants/@lesson.MaxParticipants
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center my-4">Geen recente lessen gevonden.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Participated Lessons -->
        @if (_data.ParticipatedLessons.Any())
        {
            <div class="row g-3">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0"><i class="bi bi-person-check me-2"></i>Lessen als Deelnemer</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr><th>Datum & Tijd</th><th>Workout</th><th>Instructeur</th><th>Locatie</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lesson in _data.ParticipatedLessons)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@lesson.StartTime.ToString("dd MMM yyyy")</strong>
                                                    <br /><small class="text-muted">@lesson.StartTime.ToString("HH:mm")</small>
                                                </td>
                                                <td>@lesson.WorkoutName</td>
                                                <td>@lesson.InstructorName</td>
                                                <td>@lesson.LocationName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Kon dashboard gegevens niet laden. Probeer de pagina te verversen.
        </div>
    }
</div>

@code {
    private InstructorDashboardDto? _data;
    private bool _isLoading = true;
    private string _displayName = "Instructeur";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                _displayName = user.Identity.Name ?? "Instructeur";
                var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
                if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
                {
                    _data = await DashboardService.GetInstructorDashboardAsync(userId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading instructor dashboard: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetOccupancyBadgeClass(double occupancy) => occupancy switch
    {
        >= 90 => "bg-danger",
        >= 70 => "bg-warning text-dark",
        >= 50 => "bg-info",
        _ => "bg-success"
    };

    private string GetProgressBarClass(double occupancy) => occupancy switch
    {
        >= 90 => "bg-danger",
        >= 70 => "bg-warning",
        >= 50 => "bg-info",
        _ => "bg-success"
    };
}