@page "/workouts"
@using SharedLibrary.DTOs.Responses
@using WA.Services.Http.Interfaces
@inject IWorkoutApi WorkoutApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@layout WA.Layout.AdminLayout

<PageTitle>Workouts</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Workouts</MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/workouts/create">
        Nieuwe Workout
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_loadError)
{
    <MudAlert Severity="Severity.Error">Fout bij het laden van workouts. Probeer het opnieuw.</MudAlert>
}
else
{
    <MudDataGrid T="WorkoutResponse"
                 Items="_workouts"
                 SortMode="SortMode.Multiple"
                 Filterable="true"
                 Hideable="true"
                 Dense="true"
                 Striped="true"
                 Hover="true"
                 Pageable="true"
                 PageSize="10">
        <ToolBarContent>
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Zoeken..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Clearable="true"
                          Class="mt-0" />
            <MudSpacer />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Naam" />
            <PropertyColumn Property="x => x.Description" Title="Beschrijving" />
            <PropertyColumn Property="x => x.Duration" Title="Duur" />
            <TemplateColumn Title="Acties" Sortable="false" Filterable="false" CellStyle="width: 120px; text-align: right;">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Href="@($"/workouts/edit/{context.Item.Id}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenDeleteDialog(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="WorkoutResponse" PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudDataGrid>
}

<MudDialog @bind-Visible="_deleteDialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-2" />
            Workout Verwijderen
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            Weet je zeker dat je de workout <strong>@_workoutToDelete?.Name</strong> wilt verwijderen? Dit kan niet ongedaan worden gemaakt.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDeleteDialog">Annuleren</MudButton>
        <MudButton Color="Color.Error"
                   Variant="Variant.Filled"
                   OnClick="ConfirmDeleteAsync"
                   Disabled="_deleting">
            @if (_deleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Verwijderen
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<WorkoutResponse> _workouts = new();
    private bool _loading = true;
    private bool _loadError;
    private string _searchString = "";
    
    private bool _deleteDialogOpen;
    private bool _deleting;
    private WorkoutResponse? _workoutToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkoutsAsync();
    }

    private async Task LoadWorkoutsAsync()
    {
        _loading = true;
        _loadError = false;
        try
        {
            var result = await WorkoutApi.GetWorkoutsAsync();
            _workouts = result.ToList();
        }
        catch (Exception)
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenDeleteDialog(WorkoutResponse workout)
    {
        _workoutToDelete = workout;
        _deleteDialogOpen = true;
    }

    private void CloseDeleteDialog()
    {
        _deleteDialogOpen = false;
        _workoutToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_workoutToDelete == null) return;

        _deleting = true;
        try
        {
            var success = await WorkoutApi.DeleteWorkoutAsync(_workoutToDelete.Id);
            if (success)
            {
                _workouts.Remove(_workoutToDelete);
                Snackbar.Add("Workout succesvol verwijderd", Severity.Success);
                CloseDeleteDialog();
            }
            else
            {
                Snackbar.Add("Fout bij het verwijderen van workout", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fout: {ex.Message}", Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
