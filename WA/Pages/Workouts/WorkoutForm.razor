@using SharedLibrary.DTOs.Requests
@using System.ComponentModel.DataAnnotations

<EditForm Model="@Model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <MudGrid>
        <MudItem xs="12">
            <MudTextField Label="Naam" @bind-Value="Model.Name" For="@(() => Model.Name)" Required="true" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField Label="Beschrijving" @bind-Value="Model.Description" For="@(() => Model.Description)" Lines="3" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTimePicker Label="Duur" @bind-Time="_duration" For="@(() => Model.Duration)" Required="true" />
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-end">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@Loading">
                @if (Loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Opslaan
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter] public dynamic Model { get; set; } = default!;
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public bool Loading { get; set; }

    private TimeSpan? _duration
    {
        get => Model.Duration;
        set => Model.Duration = value ?? TimeSpan.Zero;
    }
}
