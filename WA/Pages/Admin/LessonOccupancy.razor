@page "/admin/occupancy"
@using SharedLibrary.DTOs.Responses
@using WA.Services.Http.Interfaces
@layout WA.Layout.AdminLayout
@inject ILessonApi LessonApi
@inject IReservationApi ReservationApi

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudText Typo="Typo.h4" Class="mb-4">Lesbezetting</MudText>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="Toekomst">
                <OccupancyTable Lessons="@_futureLessons" Reservations="@_reservations" Loading="@_loading" />
            </MudTabPanel>
            <MudTabPanel Text="Historie">
                <OccupancyTable Lessons="@_pastLessons" Reservations="@_reservations" Loading="@_loading" />
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    private List<LessonResponse> _futureLessons = new();
    private List<LessonResponse> _pastLessons = new();
    private List<ReservationResponse> _reservations = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var lessons = await LessonApi.GetLessonsAsync();
        _reservations = (await ReservationApi.GetReservationsAsync()).ToList();

        var now = DateTime.Now;
        _futureLessons = lessons.Where(l => l.StartTime >= now).OrderBy(l => l.StartTime).ToList();
        _pastLessons = lessons.Where(l => l.StartTime < now).OrderByDescending(l => l.StartTime).ToList();
        
        _loading = false;
    }
}
