@page "/admin/instructors"
@using SharedLibrary.DTOs.Responses
@using WA.Services.Http.Interfaces
@using WA.Components
@inject IInstructorApi InstructorApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h4">Instructeur Beheer</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OnCreateClicked">
                Nieuwe Instructeur
            </MudButton>
        </MudStack>

        <MudTable Items="@_instructors" Loading="@_loading" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh>Foto</MudTh>
                <MudTh>Naam</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Specialisatie</MudTh>
                <MudTh>Acties</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Foto">
                    @if (!string.IsNullOrEmpty(context.PhotoUrl))
                    {
                        <MudAvatar Image="@context.PhotoUrl" Size="Size.Medium" />
                    }
                    else
                    {
                        <MudAvatar Color="Color.Secondary" Size="Size.Medium">@context.FirstName[0]</MudAvatar>
                    }
                </MudTd>
                <MudTd DataLabel="Naam">@context.FirstName @context.LastName</MudTd>
                <MudTd DataLabel="Email">@context.Email</MudTd>
                <MudTd DataLabel="Specialisatie">@context.Specialization</MudTd>
                <MudTd DataLabel="Acties">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="@(() => OnEditClicked(context.Id))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => OnDeleteClicked(context))" />
                </MudTd>
            </RowTemplate>
            <LoadingContent>
                <MudText>Laden...</MudText>
            </LoadingContent>
            <NoItemsContent>
                <MudText>Geen instructeurs gevonden.</MudText>
            </NoItemsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private IReadOnlyList<InstructorResponse> _instructors = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstructors();
    }

    private async Task LoadInstructors()
    {
        _loading = true;
        _instructors = await InstructorApi.GetInstructorsAsync();
        _loading = false;
    }

    private async Task OnCreateClicked()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<InstructorDialog>("Nieuwe Instructeur", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadInstructors();
            Snackbar.Add("Instructeur succesvol aangemaakt", Severity.Success);
        }
    }

    private async Task OnEditClicked(int id)
    {
        var parameters = new DialogParameters<InstructorDialog> { { x => x.InstructorId, id } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<InstructorDialog>("Instructeur Bewerken", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadInstructors();
            Snackbar.Add("Instructeur succesvol bijgewerkt", Severity.Success);
        }
    }

    private async Task OnDeleteClicked(InstructorResponse instructor)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Verwijderen", 
            $"Weet je zeker dat je {instructor.FirstName} {instructor.LastName} wilt verwijderen?", 
            yesText:"Verwijder", cancelText:"Annuleer");

        if (result == true)
        {
            var success = await InstructorApi.DeleteInstructorAsync(instructor.Id);
            if (success)
            {
                await LoadInstructors();
                Snackbar.Add("Instructeur verwijderd", Severity.Success);
            }
            else
            {
                Snackbar.Add("Fout bij verwijderen instructeur", Severity.Error);
            }
        }
    }
}
