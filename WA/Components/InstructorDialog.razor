@using SharedLibrary.DTOs.Requests
@using SharedLibrary.DTOs.Responses
@using WA.Services.Http.Interfaces
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(InstructorId == null ? "Nieuwe Instructeur" : "Instructeur Bewerken")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudTextField T="string" Label="Voornaam" Required="true" @bind-Value="_request.FirstName" />
            <MudTextField T="string" Label="Achternaam" Required="true" @bind-Value="_request.LastName" />
            <MudTextField T="string" Label="Email" InputType="InputType.Email" @bind-Value="_request.Email" />
            <MudTextField T="string" Label="Specialisatie" @bind-Value="_request.Specialization" />

            @if (InstructorId != null)
            {
                <div class="mt-4">
                    <MudText Typo="Typo.subtitle2">Foto</MudText>
                    @if (!string.IsNullOrEmpty(_photoUrl))
                    {
                        <MudImage Src="@_photoUrl" Alt="Instructor Photo" Elevation="2" Class="rounded-lg mb-2" Style="width: 100px; height: 100px; object-fit: cover;" />
                    }
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadPhoto">
                        <ButtonTemplate>
                            <MudButton HtmlTag="label"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       for="@context.Id">
                                Foto Uploaden
                            </MudButton>
                        </ButtonTemplate>
                    </MudFileUpload>
                </div>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annuleren</MudButton>
        <MudButton Color="Color.Primary" Disabled="!_formIsValid" OnClick="Submit">Opslaan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? InstructorId { get; set; }
    [Inject] private IInstructorApi InstructorApi { get; set; } = null!;

    private InstructorCreateRequest _request = new();
    private bool _formIsValid;
    private MudForm _form = null!;
    private string? _photoUrl;

    protected override async Task OnInitializedAsync()
    {
        if (InstructorId.HasValue)
        {
            var instructor = await InstructorApi.GetInstructorByIdAsync(InstructorId.Value);
            if (instructor != null)
            {
                _request = new InstructorCreateRequest
                {
                    FirstName = instructor.FirstName,
                    LastName = instructor.LastName,
                    Email = instructor.Email,
                    Specialization = instructor.Specialization
                };
                _photoUrl = instructor.PhotoUrl;
            }
        }
    }

    private async Task UploadPhoto(IBrowserFile file)
    {
        if (file == null || !InstructorId.HasValue) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
            var response = await InstructorApi.UploadPhotoAsync(InstructorId.Value, stream, file.Name, file.ContentType);
            if (response != null)
            {
                _photoUrl = response.PhotoUrl;
                Snackbar.Add("Foto succesvol geüpload", Severity.Success);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fout bij uploaden: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_formIsValid) return;

        if (InstructorId.HasValue)
        {
            var updateRequest = new InstructorUpdateRequest
            {
                FirstName = _request.FirstName,
                LastName = _request.LastName,
                Email = _request.Email,
                Specialization = _request.Specialization
            };
            var success = await InstructorApi.UpdateInstructorAsync(InstructorId.Value, updateRequest);
            if (success) MudDialog.Close(DialogResult.Ok(true));
            else Snackbar.Add("Fout bij bijwerken instructeur", Severity.Error);
        }
        else
        {
            var result = await InstructorApi.CreateInstructorAsync(_request);
            if (result != null) MudDialog.Close(DialogResult.Ok(true));
            else Snackbar.Add("Fout bij aanmaken instructeur", Severity.Error);
        }
    }
}
