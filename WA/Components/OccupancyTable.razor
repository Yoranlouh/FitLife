@using SharedLibrary.DTOs.Responses

<MudTable Items="@Lessons" Loading="@Loading" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
    <HeaderContent>
        <MudTh>Datum & Tijd</MudTh>
        <MudTh>Workout</MudTh>
        <MudTh>Instructeur</MudTh>
        <MudTh>Bezetting</MudTh>
        <MudTh>Percentage</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Datum & Tijd">@context.StartTime.ToString("g")</MudTd>
        <MudTd DataLabel="Workout">@context.WorkoutName</MudTd>
        <MudTd DataLabel="Instructeur">@context.InstructorName</MudTd>
        <MudTd DataLabel="Bezetting">
            @{
                var count = GetReservationCount(context.Id);
                var max = context.MaxParticipants;
            }
            @count / @max
        </MudTd>
        <MudTd DataLabel="Percentage">
            @{
                var count2 = GetReservationCount(context.Id);
                var percentage = context.MaxParticipants > 0 ? (double)count2 / context.MaxParticipants * 100 : 0;
            }
            <MudProgressLinear Color="@GetProgressColor(percentage)" Value="@percentage" Class="my-7">
                <MudText Typo="Typo.caption" Color="Color.Dark">@percentage.ToString("F0")%</MudText>
            </MudProgressLinear>
        </MudTd>
    </RowTemplate>
    <NoItemsContent>
        <MudText>Geen lessen gevonden.</MudText>
    </NoItemsContent>
</MudTable>

@code {
    [Parameter] public IEnumerable<LessonResponse> Lessons { get; set; } = new List<LessonResponse>();
    [Parameter] public IEnumerable<ReservationResponse> Reservations { get; set; } = new List<ReservationResponse>();
    [Parameter] public bool Loading { get; set; }

    private int GetReservationCount(int lessonId)
    {
        return Reservations.Count(r => r.LessonId == lessonId && !r.IsCancelled);
    }

    private Color GetProgressColor(double percentage) => percentage switch
    {
        >= 90 => Color.Error,
        >= 70 => Color.Warning,
        _ => Color.Success
    };
}
