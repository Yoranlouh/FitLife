@using SharedLibrary.DTOs.Requests
@using SharedLibrary.DTOs.Responses
@using WA.Services.Http.Interfaces
@inject ISnackbar Snackbar
@inject IWorkoutApi WorkoutApi
@inject IInstructorApi InstructorApi
@inject ILocationApi LocationApi
@inject ILessonApi LessonApi

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(LessonId == null ? "Nieuwe Les" : "Les Bewerken")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Workout" Required="true" @bind-Value="_request.WorkoutId" AnchorOrigin="Origin.BottomCenter" SelectedValuesChanged="OnWorkoutChanged">
                        @foreach (var workout in _workouts)
                        {
                            <MudSelectItem Value="@workout.Id">@workout.Name (@workout.Duration.TotalMinutes min)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Instructeur" Required="true" @bind-Value="_request.InstructorId" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var instructor in _instructors)
                        {
                            <MudSelectItem Value="@instructor.Id">@instructor.FirstName @instructor.LastName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Locatie" Required="true" @bind-Value="_request.LocationId" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var location in _locations)
                        {
                            <MudSelectItem Value="@location.Id">@location.Name (Capaciteit: @location.Capacity)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField Label="Max Deelnemers" @bind-Value="_request.MaxParticipants" Min="1" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDateTimePicker Label="Starttijd" @bind-DateTime="_startTime" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDateTimePicker Label="Eindtijd" @bind-DateTime="_endTime" Required="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-4" />
                    <MudSwitch @bind-Value="_request.IsRecurring" Color="Color.Primary" Label="Herhalende Les" />
                </MudItem>

                @if (_request.IsRecurring)
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Herhalingspatroon" @bind-Value="_request.RecurrencePattern" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@("Daily")">Dagelijks</MudSelectItem>
                            <MudSelectItem Value="@("Weekly")">Wekelijks</MudSelectItem>
                            <MudSelectItem Value="@("Monthly")">Maandelijks</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField Label="Interval" @bind-Value="_request.RecurrenceInterval" Min="1" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Einddatum Herhaling" @bind-Date="_recurrenceEndDate" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField Label="Aantal Herhalingen" @bind-Value="_request.RecurrenceCount" Min="1" />
                    </MudItem>
                }
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Annuleren</MudButton>
        <MudButton Color="Color.Primary" Disabled="!_formIsValid" OnClick="Submit">Opslaan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int? LessonId { get; set; }

    private LessonCreateRequest _request = new() { StartTime = DateTime.Now.AddHours(1), EndTime = DateTime.Now.AddHours(2), MaxParticipants = 20 };
    private bool _formIsValid;
    private MudForm _form = null!;

    private DateTime? _startTime = DateTime.Now.AddHours(1);
    private DateTime? _endTime = DateTime.Now.AddHours(2);
    private DateTime? _recurrenceEndDate;

    private IReadOnlyList<WorkoutResponse> _workouts = [];
    private IReadOnlyList<InstructorResponse> _instructors = [];
    private IReadOnlyList<LocationResponse> _locations = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        if (LessonId.HasValue)
        {
            var lesson = await LessonApi.GetLessonByIdAsync(LessonId.Value);
            if (lesson != null)
            {
                _request = new LessonCreateRequest
                {
                    StartTime = lesson.StartTime,
                    EndTime = lesson.EndTime,
                    MaxParticipants = lesson.MaxParticipants,
                    WorkoutId = lesson.WorkoutId,
                    InstructorId = lesson.InstructorId,
                    LocationId = lesson.LocationId,
                    IsRecurring = lesson.IsRecurring,
                    RecurrencePattern = lesson.RecurrencePattern,
                    RecurrenceInterval = lesson.RecurrenceInterval,
                    RecurrenceEndDate = lesson.RecurrenceEndDate,
                    RecurrenceCount = lesson.RecurrenceCount
                };
                _startTime = lesson.StartTime;
                _endTime = lesson.EndTime;
                _recurrenceEndDate = lesson.RecurrenceEndDate;
            }
        }
    }

    private async Task LoadData()
    {
        var workoutsTask = WorkoutApi.GetWorkoutsAsync();
        var instructorsTask = InstructorApi.GetInstructorsAsync();
        var locationsTask = LocationApi.GetLocationsAsync();

        await Task.WhenAll(workoutsTask, instructorsTask, locationsTask);

        _workouts = await workoutsTask;
        _instructors = await instructorsTask;
        _locations = await locationsTask;

        // Als het een nieuwe les is, en er is een 'NNB' instructeur, selecteer die standaard
        if (!LessonId.HasValue && _request.InstructorId == 0)
        {
            var nnbInstructor = _instructors.FirstOrDefault(i => i.FirstName.Equals("NNB", StringComparison.OrdinalIgnoreCase));
            if (nnbInstructor != null)
            {
                _request.InstructorId = nnbInstructor.Id;
            }
        }
    }

    private void OnWorkoutChanged()
    {
        if (_startTime.HasValue && _request.WorkoutId != 0)
        {
            var workout = _workouts.FirstOrDefault(w => w.Id == _request.WorkoutId);
            if (workout != null)
            {
                _endTime = _startTime.Value.Add(workout.Duration);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (!_formIsValid) return;

        _request.StartTime = _startTime ?? DateTime.Now;
        _request.EndTime = _endTime ?? _request.StartTime.AddHours(1);
        _request.RecurrenceEndDate = _recurrenceEndDate;

        if (LessonId.HasValue)
        {
            var updateRequest = new LessonUpdateRequest
            {
                StartTime = _request.StartTime,
                EndTime = _request.EndTime,
                MaxParticipants = _request.MaxParticipants,
                WorkoutId = _request.WorkoutId,
                InstructorId = _request.InstructorId,
                LocationId = _request.LocationId,
                IsRecurring = _request.IsRecurring,
                RecurrencePattern = _request.RecurrencePattern,
                RecurrenceInterval = _request.RecurrenceInterval,
                RecurrenceEndDate = _request.RecurrenceEndDate,
                RecurrenceCount = _request.RecurrenceCount
            };
            var success = await LessonApi.UpdateLessonAsync(LessonId.Value, updateRequest);
            if (success) MudDialog.Close(DialogResult.Ok(true));
            else Snackbar.Add("Fout bij bijwerken les", Severity.Error);
        }
        else
        {
            var result = await LessonApi.CreateLessonAsync(_request);
            if (result != null) MudDialog.Close(DialogResult.Ok(true));
            else Snackbar.Add("Fout bij aanmaken les", Severity.Error);
        }
    }
}
